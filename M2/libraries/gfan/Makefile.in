VERSION = 0.7+g3bad3a8f69
SHA256SUM = 1d4d54a2557c681f5bf7bad1d15eb4c1de1f4e68f17ddc71a5296880a75552ea
# PATCHFILE = @abs_srcdir@/patch-$(VERSION)
URL = https://users-math.au.dk/~jensen/software/gfan
TARFILE = gfan$(VERSION).tar.gz
TARDIR = gfanprivate-macOS-build
CONFIGURECMD = true
# adding cddnoprefix=yes here ensures that we include "cdd.h" instead of "cdd/cdd.h", which is necessary when trying to use cddlib as installed by homebrew on the Mac:
CPPFLAGS += -I$(BUILTLIBPATH)/include/cddlib -DGMPRATIONAL
BUILDOPTIONS = CC="$(CC) $(CPPFLAGS)" CXX="$(CXX) $(CPPFLAGS)"  \
	CLINKER="$(CC) $(LDFLAGS)" CCLINKER="$(CXX) $(LDFLAGS)" \
	OPTFLAGS="$(CXXFLAGS)"                                  \
	PREFIX=/nowhere CDD_LINKOPTIONS=-lcddgmp cddnoprefix=yes
INSTALLOPTIONS = PREFIX=$(LIBRARIESDIR)
CHECKTARGET = .
STRIPFILES = gfan@EXEEXT@
LICENSEFILES = LICENSE COPYING
include ../Makefile.library
Makefile: @srcdir@/Makefile.in ; cd ../.. && ./config.status libraries/gfan/Makefile
# Local Variables:
# compile-command: "make -C $M2BUILDDIR/libraries/gfan "
# End:
