#!/usr/bin/env python3
"""Post hand-written comments onto the issues that duplicate rows point at.

DRY RUN BY DEFAULT.

When a bug file turns out to be covered by an existing issue but carries
something that issue lacks -- an older reproducer, a workaround, a second symptom
of the same defect -- the useful move is a comment on the live issue rather than
a new one.  That is what actually gets the bug fixed; the board cannot do it.

Any row naming an issue may carry a comment, not only `duplicate` rows.  A row we
filed ourselves can still need one: four rows gained PR provenance -- a decision
recorded in a merged pull request, invisible from the issue -- after the issues
were already open.  Restricting this to duplicates meant those had to be posted
by hand, which is how the 1-flattenRing comment sat unposted.

**The text is never generated.**  A comment is posted only for a path with a file
under comments/, written by hand, mirroring the bug path:

    comments/bugs/dan/0-generateAssertions.md

The note column is deliberately not used for this.  Those notes are one-line
internal shorthand -- "both issues are still open" -- written for the catalog,
and posting them verbatim would read as noise on a stranger's issue.

Deciding whether a comment adds anything is the whole value here, and it is not
derivable from the TSV.  #114 got none because its content was already identical
to the bug file; #4231 deserves one because its author wrote that they could not
find the earlier discussion.  This script automates the posting, never the
judgment.

Unlike everything else in this directory, a comment notifies people.  Draft
bodies, statuses and labels are silent; a comment reaches every watcher of an
issue that may be a decade old.  Read the dry run.

Every comment opens with project.ATTRIBUTION, which says Claude wrote it and
this account only posted it.  Someone reading a comment on their own issue is
entitled to know that before deciding how much weight to give it, particularly
where the comment relays a claim rather than something verified -- see
comments/bugs/dan/0-polymake.md.  It goes first, above the text: a disclosure
placed after the content is read after the content, which is too late to be the
thing it exists to be.

    ./bin/comment-issues            # show the exact text
    ./bin/comment-issues --apply    # post

Re-running edits the comment already posted rather than adding another, found by
its trailing marker.
"""

import argparse
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import catalog
import project

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
COMMENTS = os.path.join(ROOT, "comments")


def marker_for(path):
    return "<!-- bug-triage:%s -->" % path


def comment_file(path):
    return os.path.join(COMMENTS, path + ".md")


def comment_paths():
    """Every bug path someone has written a comment for, from the files on disk."""
    for dirpath, _, filenames in os.walk(COMMENTS):
        for name in filenames:
            if name.endswith(".md"):
                yield os.path.relpath(
                    os.path.join(dirpath, name), COMMENTS)[:-len(".md")]


TARGET = re.compile(r"\A<!--\s*issue:\s*((?:#?\d+\s*)+)-->\s*\n")


def body_for(path):
    """(comment, target issues) for a path, or (None, None) if nobody wrote one.

    A file may name its own target on the first line:

        <!-- issue: #3887 -->

    which overrides the row's issue column.  1-flattenRing needs this: the row is
    open and names the issue filed from it, but the comment was written for
    someone else's issue about the same mechanism.  Without the override this
    posts a comment about #3887's discussion onto our own issue instead.
    """
    filename = comment_file(path)
    if not os.path.exists(filename):
        return None, None
    with open(filename, encoding="utf-8") as f:
        text = f.read()
    targets = None
    m = TARGET.match(text)
    if m:
        targets = m.group(1).split()
        text = text[m.end():]
    text = text.strip()
    if not text:
        return None, None
    body = "%s\n\n%s\n\n<sub>From `%s` in the pre-GitHub `bugs/` tree, being triaged in [#36](%s/issues/36).  Source of truth: [`bug-triage/catalog.tsv`](%s).</sub>\n%s" % (
        project.ATTRIBUTION, text, path, project.REPO_URL, project.CATALOG_URL,
        marker_for(path))
    return body, targets


ISSUE_QUERY = """
query($owner:String!, $name:String!, $number:Int!) {
  repository(owner:$owner, name:$name) {
    issue(number:$number) {
      id number state
      comments(first:100) { nodes { id body } }
    }
  }
}
"""

ADD_COMMENT = """
mutation($subject:ID!, $body:String!) {
  addComment(input:{subjectId:$subject, body:$body}) {
    commentEdge { node { url } }
  }
}
"""

UPDATE_COMMENT = """
mutation($id:ID!, $body:String!) {
  updateIssueComment(input:{id:$id, body:$body}) { issueComment { url } }
}
"""


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--apply", action="store_true",
                   help="actually post (default: dry run)")
    args = p.parse_args()

    rows = catalog.require(catalog.read())
    plan, skipped = [], []

    for r in rows:
        if not r["issue"]:
            continue
        body, targets = body_for(r["path"])
        if body is None:
            skipped.append(r["path"])
            continue
        # "#568 #569" means the file covers both; each gets its own comment.
        for ref in (targets or r["issue"].split()):
            number = int(ref.lstrip("#"))
            issue = project.gh(ISSUE_QUERY, owner=project.ORG, name=project.REPO,
                               number=number)["data"]["repository"]["issue"]
            if issue is None:
                print("  SKIP  %s -> #%d does not exist" % (r["path"], number))
                continue
            existing = next((c for c in issue["comments"]["nodes"]
                             if marker_for(r["path"]) in c["body"]), None)
            if existing and existing["body"] == body:
                print("  ok    %s -> #%d already current" % (r["path"], number))
                continue
            plan.append((r["path"], issue, existing, body))

    print("\n%d comments to post or update, %d rows naming an issue have no "
          "comment file\n" % (len(plan), len(skipped)))

    # The reverse check, which costs nothing and catches a comment written into a
    # void.  Only a duplicate row naming an issue reaches the loop above, so a
    # comment file beside any other row is skipped in silence -- there is no
    # "0 comments" line that distinguishes "nothing to say" from "something to say
    # and no way to say it".  1-flattenRing hit this: an open row whose comment
    # belonged on someone else's issue (#3887), written, ignored, and only noticed
    # because the queue came back empty when it should not have.
    postable = {r["path"] for r in rows if r["issue"]}
    orphans = sorted(p for p in comment_paths() if p not in postable)
    # This does not check whether the comment was posted by hand afterwards, so an
    # orphan stays listed once it has been dealt with.  Verifying would mean an API
    # call per orphan to look for the marker, and a standing reminder is the safer
    # failure: it over-reports, where saying nothing under-reported.
    if orphans:
        print("%d comment file(s) that nothing here will post -- the row names no "
              "issue.\nPost by hand (and this line will keep saying so), or fix the "
              "row:" % len(orphans))
        for path in orphans:
            print("  %s" % path)
        print()

    for path, issue, existing, body in plan:
        print("=" * 72)
        print("%s  ->  #%d (%s)%s"
              % (path, issue["number"], issue["state"],
                 "  [editing existing comment]" if existing else ""))
        print("-" * 72)
        print(body)
        print()

    if not args.apply:
        print("dry run -- nothing posted.  Re-run with --apply.")
        print("NOTE: posting notifies everyone watching those issues.")
        return

    for i, (path, issue, existing, body) in enumerate(plan, 1):
        if existing:
            project.gh(UPDATE_COMMENT, id=existing["id"], body=body)
            what = "updated"
        else:
            project.gh(ADD_COMMENT, subject=issue["id"], body=body)
            what = "posted"
        print("[%d/%d] %s %s on #%d" % (i, len(plan), what, path, issue["number"]))
    print("\n%s %d comments" % ("posted/updated", len(plan)))


if __name__ == "__main__":
    main()
