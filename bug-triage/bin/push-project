#!/usr/bin/env python3
"""One-way sync of catalog.tsv into GitHub project 46.  DRY RUN BY DEFAULT.

Project 46 (https://github.com/orgs/Macaulay2/projects/46) holds roughly one
draft issue per file from the removed bugs/ tree.  This pushes settled verdicts
onto those items, matching on the bug file path.

The board carries only the stock project-template fields -- Status, Priority,
Size, Estimate, dates -- so there is nowhere to put a verdict, an issue number, a
fix, or a note.  Rather than add five custom fields to a shared org board, the
narrative goes into the body of the draft itself, between HTML comment markers,
and only the coarse state goes into a field.  See want_status below for the
mapping, and read the comment there before changing it.

The block is replaced, not appended to, so this is safe to re-run as verdicts get
revised.  That holds for converted items too: once a draft becomes a real issue
the project API can no longer touch it, so the block there is refreshed through
updateIssue instead.  Without that, revising a verdict after filing leaves the
public issue contradicting catalog.tsv permanently -- which is how #4514, #4528
and #4529 came to sit closed while still publishing "Verdict: open".

A block is only ever *replaced* on a real issue, never introduced.  An issue on
the board carrying no block was not filed from this catalog, and appending our
triage to someone else's issue is not ours to do.

Nothing here creates items, deletes items, or creates fields.

    ./bin/push-project                 # show what would change
    ./bin/push-project --check         # one line; exit 1 if the board is behind
    ./bin/push-project --apply         # actually write

Requires the "project" scope, which the default gh token does not have:

    gh auth refresh -s project

--apply performs one GraphQL mutation per changed item and cannot be undone in
bulk.  Read the dry-run output first.
"""

import argparse
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import catalog
import project

BEGIN, END, BLOCK_RE = project.BEGIN, project.END, project.BLOCK_RE

# The board has "Auto-close issue" enabled, so setting Status to Done on an item
# that is a real issue closes that issue.  Drafts have no open/closed state and
# are safe, but a row that comes out "open" is a live bug: once its draft is
# converted, Done would close the very issue we just filed.  So a still-broken
# bug never reaches Done -- Ready means it needs an issue, In progress means one
# exists and the bug is somebody's to fix.
STATUS_TODO = "Backlog"
STATUS_NEEDS_ISSUE = "Ready"
STATUS_TRACKED = "In progress"
STATUS_SETTLED = "Done"

ALL_STATUSES = (STATUS_TODO, STATUS_NEEDS_ISSUE, STATUS_TRACKED, STATUS_SETTLED)


def is_closed(item):
    return (item["content"] or {}).get("state") == "CLOSED"


def want_status(row, item):
    """Where this row belongs on the board.

    A closed issue is already Done: the board's "Item closed" workflow put it
    there.  Insisting on In progress because the catalog still says open would
    shove a settled bug back into the work queue on every push, and --check would
    never converge.  Defer to the tracker and report the row instead -- only a
    human can say whether it closed as fixed, wontfix or duplicate.
    """
    if row["verdict"] == "todo":
        return STATUS_TODO
    if row["verdict"] == "open":
        if is_closed(item):
            return STATUS_SETTLED
        return STATUS_TRACKED if row["issue"] else STATUS_NEEDS_ISSUE
    return STATUS_SETTLED


REPO_URL, CATALOG_URL = project.REPO_URL, project.CATALOG_URL

ISSUE_REF = re.compile(r"#(\d+)")
SHA_REF = re.compile(r"\b([0-9a-f]{7,40})\b")


def linkify(text):
    """Make issue and commit references clickable.

    A draft issue lives in the project, not in a repository, so bare "#114" and
    bare shas render as plain text there.  /issues/N redirects to /pull/N, so one
    form covers issues and PRs alike.
    """
    text = ISSUE_REF.sub(
        lambda m: "[#%s](%s/issues/%s)" % (m.group(1), REPO_URL, m.group(1)), text)
    return SHA_REF.sub(
        lambda m: "[`%s`](%s/commit/%s)" % (m.group(1)[:10], REPO_URL, m.group(1)),
        text)


def block_for(row, self_issue=None):
    """The triage block for a row, or None if it has nothing to say yet.

    self_issue is the number of the issue this block is being written into, if
    any.  A row filed from this catalog ends up naming its own issue, and
    "Issue: #4526" in the body of #4526 is noise -- while "Issue: #101" in the
    body of #4529, a row later settled as a duplicate, is the useful case.  So
    the field is dropped only when it names nothing but the issue you are
    already reading.
    """
    if row["verdict"] in ("", "todo") and not any(
            row[c] for c in ("issue", "fix", "disposition", "note")):
        return None
    bits = []
    for column, label in (("verdict", "Verdict"), ("issue", "Issue"),
                          ("fix", "Fix"), ("disposition", "Disposition")):
        if column == "issue" and self_issue and row["issue"] == "#%s" % self_issue:
            continue
        if row[column]:
            value = linkify(row[column]) if column in ("issue", "fix") else row[column]
            bits.append("**%s:** %s" % (label, value))
    lines = [BEGIN, "", "---", "", " &middot; ".join(bits)]
    if row["note"]:
        lines += ["", "> " + linkify(row["note"])]
    lines += ["", "<sub>Triaged from `%s`; see [#36](%s/issues/36).  Source of truth: "
              "[`bug-triage/catalog.tsv`](%s).</sub>"
              % (row["path"], REPO_URL, CATALOG_URL), END]
    return "\n".join(lines)


def merged_body(old, block):
    """Replace an existing block, or append one, leaving the bug file intact."""
    old = old or ""
    if BLOCK_RE.search(old):
        return BLOCK_RE.sub(lambda _: block, old, count=1)
    return (old.rstrip() + "\n\n" + block + "\n") if old.strip() else block + "\n"


SET_STATUS = """
mutation($project:ID!, $item:ID!, $field:ID!, $value:String!) {
  updateProjectV2ItemFieldValue(input:{
    projectId:$project, itemId:$item, fieldId:$field,
    value:{singleSelectOptionId:$value}}) { projectV2Item { id } }
}
"""

SET_BODY = """
mutation($draft:ID!, $body:String!) {
  updateProjectV2DraftIssue(input:{draftIssueId:$draft, body:$body}) {
    draftIssue { id }
  }
}
"""

SET_ISSUE_BODY = """
mutation($issue:ID!, $body:String!) {
  updateIssue(input:{id:$issue, body:$body}) { issue { number } }
}
"""


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--apply", action="store_true",
                   help="actually write to the project (default: dry run)")
    p.add_argument("--include-todo", action="store_true",
                   help="also push rows still marked todo")
    p.add_argument("--check", action="store_true",
                   help="report only whether the board is in sync; exit 1 if not")
    args = p.parse_args()

    rows = catalog.require(catalog.read())
    if not args.include_todo:
        rows = [r for r in rows if r["verdict"] != "todo"]
    if not rows:
        raise SystemExit("nothing settled to push yet")

    proj, fields = project.fetch_project()
    print("project: %s (%s)" % (proj["title"], proj["id"]))

    status = fields.get(project.STATUS_FIELD.lower())
    if status is None:
        raise SystemExit("no %r field on the board" % project.STATUS_FIELD)
    options = {o["name"].lower(): o["id"] for o in status.get("options", [])}
    for want in ALL_STATUSES:
        if want.lower() not in options:
            raise SystemExit("%r field has no %r option (has: %s)"
                             % (project.STATUS_FIELD, want,
                                ", ".join(o["name"] for o in status["options"])))

    items = project.fetch_items()
    by_key = project.match(rows, items)
    print("%d items on the board, %d matched to catalog rows\n"
          % (len(items), len(by_key)))

    body_edits, issue_edits, status_edits = [], [], []
    unmatched, foreign, stale = [], [], []
    for r in rows:
        item = by_key.get(r["path"])
        if item is None:
            unmatched.append(r["path"])
            continue

        if r["verdict"] == "open" and is_closed(item):
            stale.append((r["path"], r["issue"]))

        want = want_status(r, item)
        if project.status_of(item) != want:
            status_edits.append((r["path"], item["id"], options[want.lower()], want))

        block = block_for(r, item["content"].get("number"))
        if block is None:
            continue
        old = item["content"].get("body") or ""
        new = merged_body(old, block)
        if item["type"] == "DRAFT_ISSUE":
            if new != old:
                body_edits.append((r["path"], item["content"]["id"], new, block))
        elif BLOCK_RE.search(old):
            # A converted item is a public issue, and updateProjectV2DraftIssue
            # cannot touch it.  Refresh through updateIssue instead: a verdict
            # revised after filing would otherwise leave the issue contradicting
            # catalog.tsv for good, which is how #4514, #4528 and #4529 came to
            # sit closed while still publishing "Verdict: open".
            #
            # Only ever *replace* a block here, never introduce one.  An issue on
            # the board with no block was not filed from this catalog -- someone
            # added it by hand -- and appending our triage to a stranger's issue
            # is not ours to do.
            if new != old:
                issue_edits.append((r["path"], item["content"]["id"],
                                    item["content"]["number"], new, block))
        else:
            foreign.append(r["path"])

    if args.check:
        pending = len(body_edits) + len(issue_edits) + len(status_edits)
        print("board is %s: %d body, %d issue body, %d status, %d unmatched%s"
              % ("in sync" if not pending else "behind catalog.tsv",
                 len(body_edits), len(issue_edits), len(status_edits), len(unmatched),
                 ", %d closed upstream" % len(stale) if stale else ""))
        raise SystemExit(1 if pending else 0)

    print("%d body updates, %d issue body updates, %d status updates"
          % (len(body_edits), len(issue_edits), len(status_edits)))
    if unmatched:
        print("%d rows match no board item: %s"
              % (len(unmatched), ", ".join(unmatched[:5])))
    if foreign:
        print("%d rows are issues carrying no triage block -- left alone: %s"
              % (len(foreign), ", ".join(foreign)))
    if stale:
        print("\n%d rows still say verdict=open but their issue has been closed."
              "\nUpdate catalog.tsv -- only you can say whether it closed as fixed,"
              " wontfix or duplicate:" % len(stale))
        for path, issue in stale:
            print("  %-55s %s" % (path, issue))

    for path, _, _, want in status_edits:
        print("  status  %-55s -> %s" % (path, want))
    for path, _, _, block in body_edits:
        print("\n  body    %s" % path)
        for line in block.splitlines():
            if line and line not in (BEGIN, END):
                print("          | %s" % line)
    for path, _, number, _, block in issue_edits:
        print("\n  issue   %s  (public issue #%s)" % (path, number))
        for line in block.splitlines():
            if line and line not in (BEGIN, END):
                print("          | %s" % line)

    if not args.apply:
        print("\ndry run -- nothing written.  Re-run with --apply to write.")
        return

    for i, (path, item_id, option_id, want) in enumerate(status_edits, 1):
        project.gh(SET_STATUS, project=proj["id"], item=item_id,
                   field=status["id"], value=option_id)
        print("[status %d/%d] %s -> %s" % (i, len(status_edits), path, want))
    for i, (path, draft_id, new, _) in enumerate(body_edits, 1):
        project.gh(SET_BODY, draft=draft_id, body=new)
        print("[body %d/%d] %s" % (i, len(body_edits), path))
    for i, (path, issue_id, number, new, _) in enumerate(issue_edits, 1):
        project.gh(SET_ISSUE_BODY, issue=issue_id, body=new)
        print("[issue %d/%d] %s -> #%s" % (i, len(issue_edits), path, number))
    print("\napplied %d updates"
          % (len(status_edits) + len(body_edits) + len(issue_edits)))


if __name__ == "__main__":
    main()
