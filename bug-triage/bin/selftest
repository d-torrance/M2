#!/usr/bin/env python3
"""Regression tests for the predicates here that have shipped wrong, or would.

Neither is complicated, and that is the point: both are one-line rules over text,
both looked obviously right, and both were wrong in a way no dry run showed until
something had already been published or recorded.

    project.ISSUE_REF   decides whether "#123" is an issue reference or M2 code.
                        Shipped matching only word characters before the "#", so
                        "(x+1)#0" was published as a link to issue 0 -- twice,
                        the second time live on the board for weeks.

    run-repros.truncated  decides whether a script stopped at an "end" line before
                        its real content.  Shipped as an exact match on "end", so
                        "end--" was invisible and eight reproducers were recorded
                        "pass" having run nothing.

Both lists below are drawn from files that actually exist in this catalog rather
than invented, and both carry the two error modes a predicate has: it must fire
when it should, and stay quiet when it shouldn't.

The open-issue sweep adds five more, each guarding a failure that is silent:

    CRLF bodies         a fence regex under re.M matches nothing when a "\r" sits
                        before the "\n", and reports "this issue has no code
                        block" -- true-looking, and wrong for two thirds of them.
    transcript parsing  a prompt line whose input is dropped yields a script that
                        runs clean because it never reached the bug.
    output tokens       the rule M2 draws across a wrapped value must not survive
                        as a "-" token, and "<---" must compare equal to "<--".
    check_labels        the exclusion test has to see the labels an issue already
                        carries, or "bug" lands on a "feature request".
    dup direction       "dup" names the older issue.  Backwards closes the one
                        that should have survived, and nothing else would notice.
    approvals           the gate that refuses to publish what Doug has not
                        approved.  Keyed on a hash of the payload as sent, so the
                        case that has to work is the one nothing before it
                        covered: text approved, then revised, then published.

    bin/selftest        # silent on success, nonzero exit on failure
    bin/selftest -v     # print every case
"""

import collections
import importlib.machinery
import subprocess
import importlib.util
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))


# Paths for the ask-key round trip below.  Drawn from the catalog, and chosen for
# the characters that could plausibly break a split: dots, hyphens, digits, a
# subdirectory, and a name that already ends in a digit.
ASK_KEY_PATHS = [
    "bugs/dan/IDEAS",
    "bugs/dan/0-bugs-decker.m2",
    "bugs/mike/gbB-refactor-gb/gb-one-minute.m2",
    "bugs/mike/git-issue242-243-244.m2",
    "bugs/anton/NumericalAG/_numericalID_example.m2",
]


def load(name, filename):
    """Import a sibling script by path.

    The loader has to be given explicitly: the scripts here have no .py suffix,
    and spec_from_file_location returns None rather than raising when it cannot
    guess one, so the failure arrives later as 'NoneType has no attribute loader'.
    """
    path = os.path.join(HERE, filename)
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


project = load("project", "project.py")
runrepros = load("runrepros", "run-repros")
extract = load("extractrepros", "extract-repros")
runissues = load("runissuerepros", "run-issue-repros")
publish = load("publishverdicts", "publish-verdicts")
sys.path.insert(0, HERE)
import approvals
import issues as issuestsv
catalog = load("catalog", "catalog.py")
pushproject = load("pushproject", "push-project")
indexfiles = load("indexfiles", "index-files")
scoring = load("scoring", "score")
clustering = load("clustering", "cluster")

# ------------------------------------------------------- want_status on a split
#
# A wishlist file's card is Done once every ask in it is settled -- that is what
# "we have successfully triaged this file" means, and it is the only way those
# cards ever leave the board.  The condition first shipped as "the path appears
# in asks.tsv at all", which is a different claim: splitting a file is one edit
# and triaging its asks is a week's work, so the card would have announced itself
# triaged while every ask in it still said todo.  It made no difference at the
# time, because every ask then in the file was already settled -- which is
# exactly the state in which a wrong predicate leaves no trace.
#
# (row verdict, row issue, ask verdicts, expected status)
WANT_STATUS = [
    ("open", "#4640 #4641", ["open", "open"],          "Done"),
    ("fixed", "",           ["fixed", "wontfix"],      "Done"),
    ("todo", "",            ["fixed", "todo"],         "Backlog"),
    ("open", "#4644",       ["fixed", "todo"],         "In progress"),
    ("open", "",            ["todo"],                  "Ready"),
    ("open", "",            [],                        "Ready"),
    ("open", "#4644",       [],                        "In progress"),
    ("wontfix", "",         [],                        "Done"),
]

# ---------------------------------------------------------------- linkify

# (text, the reference that must come out as a link)
LINKED = [
    ("see #4610 for details", "#4610"),
    ("#36 opens the batch", "#36"),
    ("(#2130) is the closed one", "#2130"),
    ("PR #3748, merged 2026-03-17", "#3748"),
    ("closed as a duplicate of #101.", "#101"),
    ("Macaulay2/M2-emacs#102 is somebody else's", "Macaulay2/M2-emacs#102"),
]

# Text that must survive untouched.  Every one of these is M2 code.
NOT_LINKED = [
    "the fix applies it to v#0, the underlying matrix",
    "packages.m2:437 tests class sym#1 and reports nam",
    'commandLine#0 | " --help"',
    "the length is 1 and (x+1)#0 is the RawRingElement",
    'B := ((value getGlobalSymbol "fourierMotzkin") A)#0, replacing them',
    'value LLLBases.Dictionary#"LLL"',
    "peek gives R{x+1}, and {1,2,3}#2 is 3",
    "an array [1,2,3]#0 is 1",
]

# Already a markdown link: must survive untouched.  Linkifying these again gave
# "[[#4621](url)](url)" in four filed issues -- see the comment at ISSUE_REF.
ALREADY_LINKED = [
    "see [#4621](https://github.com/Macaulay2/M2/issues/4621) for the engine side",
    "[#150](https://github.com/Macaulay2/M2/issues/150) and [#4459](https://github.com/Macaulay2/M2/pull/4459)",
    "closes [#36](https://github.com/Macaulay2/M2/issues/36).",
]

# Known and accepted: "/" is excluded from the lookbehind, so in a
# slash-separated list only the first reference becomes a link.  Three notes
# spell one that way ("#4576/#4578/#4583", "#1061/#1067").  Left alone
# deliberately -- widening the class would start linkifying URL fragments.
KNOWN_UNLINKED = ["#4576/#4578/#4583 share a shape"]

# ---------------------------------------------------------------- truncated

# Lines that ARE an "end" statement and must stop the script.
END_LINES = [
    "end",
    "end--",
    "end;",
    "end -- paste the rest in by hand",
    "end;  -- and a comment too",
    "end -* block comment *-",
]

# Lines that merely start with those three letters and must not.
NOT_END_LINES = [
    "endPackage",
    'endPackage "Foo"',
    "endl",
    '<< "done" << endl',
    "ending = true",
    "end3 = 7",
]


# ---------------------------------------------------------------- key_of
#
# An ask's issue body says "triaged from one request inside `bugs/dan/IDEAS`",
# which project.TRIAGED_FROM matches.  by_key uses setdefault, so if the ask's
# issue reached that key before the file's own draft did, bin/push-project would
# rewrite the ask with the file-level layout and set its status from the file
# row.  The marker has to win, whatever the prose says.
ASK_BODIES = [
    "<!-- bug-triage-ask: bugs/dan/IDEAS::3 -->\n\ntriaged from `bugs/dan/IDEAS`",
    "<!--bug-triage-ask:bugs/dan/IDEAS::3-->\n\nTriaged from `bugs/dan/IDEAS`",
    "<!-- bug-triage-ask:  bugs/dan/IDEAS::3  -->\n\nno path prose at all",
]

# A file-level body must still resolve to its path, marker absent.
FILE_BODIES = [
    ("Triaged from `bugs/dan/IDEAS`; see #36.", "bugs/dan/IDEAS"),
    ("triaged from `bugs/mike/gbB-refactor-gb/master-f4`", "bugs/mike/gbB-refactor-gb/master-f4"),
    # The linked form, which issue bodies now use.  TRIAGED_FROM demanded a backtick
    # immediately after "from ", so this stopped matching and 108 issues silently
    # fell back to a title-derived key and went unmatched -- push-project could
    # never have updated them again.
    ("triaged from [`bugs/dan/IDEAS`](https://github.com/Macaulay2/M2/blob/abc/bugs/dan/IDEAS), one of",
     "bugs/dan/IDEAS"),
    ("This issue was triaged from [`bugs/mike/0-GF-division.m2`](https://x), one of the 857",
     "bugs/mike/0-GF-division.m2"),
]


# ----------------------------------------------------------- open-issue sweep

# A body exactly as GitHub returns one from a browser textarea.  The "\r" is the
# whole point: written with real CRLF, not escaped, so a future reformat that
# "tidies" it also removes what it tests.
CRLF_BODY = ("Here is the problem.\r\n"
             "\r\n"
             "```\r\n"
             "R = QQ[x]\r\n"
             "mingens ideal(x)\r\n"
             "```\r\n")

# One pasted session, carrying every line class the parser has to tell apart:
# a banner, a prompt with inline input, a prompt whose input is on the indented
# line below it, an "oN =" value with an indented continuation, an "oN :" type
# line, a diagnostic, and an unindented line that is neither -- which must be
# commented rather than guessed at.
TRANSCRIPT = """Macaulay2, version 1.26.06
with packages: Core
i1 : R = QQ[x,y];

i2 :
     A = matrix {{1,2},{3,4}}

o2 = | 1 2 |
     | 3 4 |

o2 : Matrix

i3 : mingens ideal(x)
stdio:3:1:(3): error: no method for mingens
196884 = 196883 + 1
"""

# Recorded output blocks as bin/extract-repros collects them, with the rule M2
# draws across a wrap and the arrow it used to spell with three dashes.
OUTPUT_BLOCKS = [
    ["o1 = | a b",
     "     --------------------------------------------------",
     "     c d |"],
    ["o1 : Matrix R  <--- R"],
]


def main():
    verbose = "-v" in sys.argv
    failures = []

    ran = []

    def check(ok, label, detail=""):
        ran.append(label)
        if not ok:
            failures.append(label + (("  -> " + detail) if detail else ""))
        if verbose:
            print("%s  %s" % ("ok  " if ok else "FAIL", label))

    for text, ref in LINKED:
        out = project.linkify(text)
        check(("[%s](" % ref) in out, "link %s in %r" % (ref, text), out)
    for text in NOT_LINKED:
        out = project.linkify(text)
        check("/issues/" not in out, "no link in %r" % text, out)
    # A bug file link must point into Macaulay2/M2 at the pre-removal commit, not
    # into the fork's bug-triage/files/, which is gitignored and 404s.  Four filed
    # issues carried the dead form.  Also checks the sha is a full 40 characters:
    # an abbreviated one would work today and could go ambiguous later.
    u = project.file_url("bugs/dan/IDEAS")
    check(u.startswith("https://github.com/Macaulay2/M2/blob/"),
          "file_url points at the canonical repository", u)
    check(u.endswith("/bugs/dan/IDEAS"), "file_url keeps the catalog path", u)
    check("bug-triage/files" not in u, "file_url avoids the gitignored copy", u)
    check(len(project.REMOVAL_PARENT) == 40 and
          all(c in "0123456789abcdef" for c in project.REMOVAL_PARENT),
          "REMOVAL_PARENT is a full sha", project.REMOVAL_PARENT)
    # Shape is not enough now that ~180 published links depend on this commit.  If
    # history were ever rewritten past it they would all break at once, so check
    # the object is really here and really has the bugs/ tree under it.
    for probe in ("bugs/dan/IDEAS", "bugs/mike/0-GF-division.m2",
                  "bugs/gfurnish/TODO"):
        ok = subprocess.run(
            ["git", "cat-file", "-e", "%s:%s" % (project.REMOVAL_PARENT, probe)],
            cwd=HERE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        check(ok, "REMOVAL_PARENT still has %s" % probe)

    for text in ALREADY_LINKED:
        out = project.linkify(text)
        check(out == text, "already-linked text is untouched: %r" % text, out)
    for text in KNOWN_UNLINKED:
        if verbose:
            print("note  only the first is linked: %s" % project.linkify(text))

    for line in END_LINES:
        check(bool(runrepros.END_STATEMENT.match(line)), "end statement %r" % line)
    for line in NOT_END_LINES:
        check(not runrepros.END_STATEMENT.match(line), "not an end statement %r" % line)

    # bin/file-asks recovers a path from an ask key by splitting on the LAST
    # "::", and writes the resulting issue number onto that path's catalog row.
    # Get it wrong and an issue is recorded against the wrong file -- silently,
    # because every path here is real and by_path would not raise.  The rule is
    # sound only while no path contains "::", which is checked below against the
    # live catalog rather than assumed.
    for path in ASK_KEY_PATHS:
        key = catalog.ask_key({"path": path, "n": "7"})
        check(key.rsplit("::", 1)[0] == path, "ask key round-trips %r" % path, key)
        check(key.rsplit("::", 1)[1] == "7", "ask number survives %r" % path, key)
    live = [r["path"] for r in catalog.read() if "::" in r["path"]]
    check(not live, "no catalog path contains '::'", ", ".join(live[:3]))

    # The marker must beat the prose, and must not disturb file-level bodies.
    for body in ASK_BODIES:
        got = project.key_of({"content": {"body": body, "title": "a readable title"}})
        check(got == "bugs/dan/IDEAS::3", "ask marker wins over prose", repr(got))
    for body, want in FILE_BODIES:
        got = project.key_of({"content": {"body": body, "title": "a readable title"}})
        check(got == want, "file body still keys on %r" % want, repr(got))

    # An open item, so is_closed stays false and the tracker override never fires;
    # the closed-issue case is covered by the board's own "Item closed" workflow.
    item = {"content": {"state": "OPEN"}}
    for verdict, issue, ask_verdicts, want in WANT_STATUS:
        row = {"path": "bugs/dan/0-bugs-decker.m2", "verdict": verdict, "issue": issue}
        split = ({row["path"]: [{"n": str(i + 1), "verdict": v}
                                for i, v in enumerate(ask_verdicts)]}
                 if ask_verdicts else {})
        got = pushproject.want_status(row, item, split)
        check(got == want, "want_status(%s, %r asks) is %s" % (verdict, ask_verdicts, want), got)

    # --- CRLF: the fence has to be found through the carriage returns -------
    body = issuestsv.lf(CRLF_BODY)
    check("\r" not in body, "lf() removes every carriage return")
    bs = extract.blocks(body)
    check(len(bs) == 1, "a CRLF body still yields its fenced block", str(len(bs)))
    check(bs and "mingens" in bs[0].text, "the block keeps its content")
    check(not extract.blocks(CRLF_BODY),
          "and the raw CRLF body finds nothing, which is why lf() is not optional")

    # --- transcript parsing --------------------------------------------------
    script, expected, doubtful, outputs = extract.transcript_to_script(TRANSCRIPT)
    lines = [l for l in script.split("\n") if l.strip()]
    check("R = QQ[x,y];" in lines, "inline input after a prompt is kept", script)
    check("A = matrix {{1,2},{3,4}}" in lines,
          "indented input under a bare prompt is kept", script)
    check("mingens ideal(x)" in lines, "input before a diagnostic is kept", script)
    check(not any(l.startswith("i1") or l.startswith("i2") for l in lines),
          "no prompt survives into the script", script)
    check(not any("| 1 2 |" in l for l in lines if not l.startswith("--")),
          "output does not survive into the script", script)
    check(not any("Macaulay2, version" in l for l in lines),
          "the banner is dropped", script)
    check(expected == ["error: no method for mingens"],
          "the diagnostic is captured with its position stripped", repr(expected))
    check(doubtful == ["196884 = 196883 + 1"],
          "the line the parser cannot place is flagged", repr(doubtful))
    check(any(l.startswith("-- ??") for l in lines),
          "and is commented out rather than dropped or guessed at", script)
    check(len(outputs) == 2, "both output blocks are recorded", str(len(outputs)))

    # --- output tokens: layout is not the claim ------------------------------
    toks = extract.tokens(OUTPUT_BLOCKS)
    check(toks == ["| a b c d |", "Matrix R <- R"],
          "wrap rule dropped, arrow normalized, oN prefix removed", repr(toks))
    check(all("-" not in t.split() for t in toks),
          "no bare dash token survives a wrapped value", repr(toks))

    # --- expected_recurred: longest match, not any ---------------------------
    check(runissues.expected_recurred(
              ["error: no method for mingens"],
              "stdio:9:1:(3): error: no method for mingens"),
          "a recorded diagnostic is recognized despite a different position")
    check(not runissues.expected_recurred(
              ["error: no method for mingens"], "error: assertion failed"),
          "an unrelated failure is not scored as a reproduction")
    check(not runissues.expected_recurred(["error:"], "error: anything at all"),
          "a message too short to discriminate never matches")

    # --- check_labels sees what the issue already carries --------------------
    known = {"bug": "1", "feature request": "2", "Engine": "3"}
    try:
        project.check_labels({"1": ["bug"]}, known,
                             existing={"1": ["feature request"]})
        check(False, "adding 'bug' to a 'feature request' issue must be refused")
    except SystemExit:
        check(True, "adding 'bug' to a 'feature request' issue is refused")
    try:
        project.check_labels({"1": ["bug"]}, known, existing={"1": ["Engine"]})
        check(True, "a non-exclusive existing label is fine")
    except SystemExit:
        check(False, "a non-exclusive existing label must not be refused")
    try:
        project.check_labels({"1": ["bug"]}, known)
        check(True, "the two-argument call still works for bin/file-issues")
    except SystemExit:
        check(False, "the two-argument call must keep working")

    # --- follow-up comments post below, not over, the originals --------------
    # The failure this guards is silent: a single per-issue marker makes a
    # correction overwrite the comment it corrects, and the result reads as an
    # apology for something invisible.
    import tempfile, shutil
    tmp = tempfile.mkdtemp()
    try:
        for name in ("77.md", "77.2.md", "77.3.md", "78.md"):
            open(os.path.join(tmp, name), "w").write("body of " + name)
        saved = issuestsv.COMMENTS
        issuestsv.COMMENTS = tmp
        got = publish.comment_files(77)
        check([k for k, _ in got] == ["77", "77.2", "77.3"],
              "follow-ups are found in order", repr([k for k, _ in got]))
        check([k for k, _ in publish.comment_files(78)] == ["78"],
              "an issue with no follow-up yields one comment")
        check(publish.marker_for("77") != publish.marker_for("77.2"),
              "each comment carries its own marker")
        check(publish.marker_for("77") in publish.build_body(77, "77", "x"),
              "the marker is embedded in the body it identifies")
        open(os.path.join(tmp, "77.5.md"), "w").write("gap")
        check([k for k, _ in publish.comment_files(77)] == ["77", "77.2", "77.3"],
              "numbering stops at the first gap rather than skipping it")
    finally:
        issuestsv.COMMENTS = saved
        shutil.rmtree(tmp, ignore_errors=True)

    # --- dup direction, on the live catalog ----------------------------------
    # A bare dup must name an older issue; "supersedes #N" is the longhand that
    # deliberately closes into a newer one, so it is exempt from the sweep.
    backwards = [r["issue"] for r in issuestsv.read()
                 if not issuestsv.SUPERSEDES_RE.match(r.get("dup", "").strip())
                 and (issuestsv.dup_number(r) or 0) >= int(r["issue"])]
    check(not backwards, "every bare dup in issues.tsv names an older issue",
          ", ".join("#" + n for n in backwards[:5]))
    try:
        issuestsv.check_dup({"issue": "100", "dup": "#200"})
        check(False, "a backwards dup must be refused")
    except ValueError:
        check(True, "a backwards dup is refused")
    # The exemption has to be opt-in by spelling, or it is not a guard at all.
    issuestsv.check_dup({"issue": "100", "dup": "supersedes #200"})
    check(issuestsv.dup_number({"issue": "100", "dup": "supersedes #200"}) == 200,
          "\"supersedes #N\" is allowed and resolves to the survivor")
    issuestsv.check_dup({"issue": "100", "dup": "#50"})
    check(issuestsv.dup_number({"issue": "100", "dup": "#50"}) == 50,
          "a bare older dup still resolves to the survivor")
    for bad in ("supersedes", "supersedes #", "see #200", "#200 supersedes"):
        try:
            issuestsv.check_dup({"issue": "100", "dup": bad})
            check(False, "dup %r must be refused" % bad)
        except ValueError:
            check(True, "dup %r is refused" % bad)

    # --- apply-types counts the rows it is NOT changing -----------------------
    # A batch of ten reported as "7 issue(s)" hides whether the other three were
    # pre-typed and re-read, or never opened.  Doug caught that by subtraction on
    # batch 15; the second list exists so nobody has to.
    applytypes = load("applytypes", "apply-types")
    row = lambda n, **kw: dict({"issue": str(n), "created": "2018-01-01", "type": "",
                                "settype": "", "verdict": "todo", "note": ""}, **kw)
    work, kept = applytypes.plan([
        row(1, settype="Bug"),                                  # untyped -> typed
        row(2, type="Feature", settype="Bug"),                  # retyped
        row(3, type="Feature", verdict="reproduces"),           # re-read, kept
        row(4, type="Feature", settype="Feature",
            verdict="stands"),                                  # asked for what it has
        row(5, type="Feature"),                                 # pre-typed, untriaged
        row(6, verdict="stands"),                               # triaged, still untyped
    ], None, None)
    check(sorted(int(r["issue"]) for r, _, _ in work) == [1, 2],
          "plan proposes only rows whose settype differs")
    check(sorted(int(r["issue"]) for r, _ in kept) == [3, 4],
          "kept holds triaged rows that already carry the type they want",
          sorted(int(r["issue"]) for r, _ in kept))
    # #5 is the one that must stay out: untriaged, so its type is unexamined rather
    # than confirmed, and counting it would assert a re-read that never happened.
    check(5 not in [int(r["issue"]) for r, _ in kept],
          "an untriaged pre-typed row is not reported as left as is")
    check(6 not in [int(r["issue"]) for r, _ in kept],
          "a triaged row with no type at all is not reported as left as is")


    # ------------------------------------------- close must not outrun the labels
    # apply-types and apply-labels skip closed issues, so publish-verdicts has to
    # refuse a close whose annotations have not landed.  Closing first cost #603,
    # #604 and #606 their type and label and needed a hand repair.
    def gh_issue(type_name=None, labels=()):
        return {"issueType": {"name": type_name} if type_name else None,
                "labels": {"nodes": [{"name": l} for l in labels]}}

    row = {"action": "close", "settype": "Bug", "addlabels": "Core, Engine"}
    check(publish.pending_annotations(row, gh_issue("Bug", ["Core", "Engine"])) == [],
          "nothing pending once the type and both labels are on the issue")
    check(publish.pending_annotations(row, gh_issue(None, ["Core", "Engine"]))
          == ["type Bug"], "an unset type is pending")
    check(publish.pending_annotations(row, gh_issue("Bug", ["Core"]))
          == ["label(s) Engine"], "a missing label is pending")
    check(len(publish.pending_annotations(row, gh_issue(None, []))) == 2,
          "a bare issue has both the type and the labels pending")
    check(publish.pending_annotations(row, gh_issue("Task", ["Core", "Engine"]))
          == ["type Bug"], "a type that disagrees with settype is pending")
    check(publish.pending_annotations(
              {"action": "close", "settype": "", "addlabels": ""},
              gh_issue(None, [])) == [],
          "a row that asks for no annotation blocks nothing")
    check(publish.pending_annotations(row, gh_issue("Bug", ["Core", "Engine", "stale"]))
          == [], "an extra label somebody else added is not pending")

    # ------------------------------------------------- the approval gate
    # The rule this enforces has failed five times, every one of them to
    # inattention rather than to disagreement, so the cases that matter are the
    # ones where something *looks* approved: a near-miss on the payload, an
    # approval for the neighbouring issue, an approval of the comment standing in
    # for the close.  Each of those is a way a real batch goes out unread.
    def led(action, number, key, payload):
        return {"action": action, "issue": str(number), "key": key,
                "sha256": approvals.digest(payload)}

    body = "Still reproduces on 1.26.06.\n"
    ledger = [led("comment", 927, "927", body)]

    check(approvals.approved("comment", 927, "927", body, ledger),
          "an approval matches the exact text it was given for")
    check(not approvals.approved("comment", 927, "927", body + " ", ledger),
          "text revised after approval is NOT approved -- one trailing space")
    check(not approvals.approved("comment", 928, "928", body, ledger),
          "an approval does not carry to the next issue")
    check(not approvals.approved("comment", 927, "927.2", body, ledger),
          "a follow-up comment needs its own approval, not the first one's")
    check(not approvals.approved("close", 927, "", body, ledger),
          "approving the comment does not approve the close")

    # The close payload has to distinguish the duplicate target, or an approval to
    # close as not-planned would authorize closing into an arbitrary issue.
    check(approvals.close_payload("DUPLICATE", 364)
          != approvals.close_payload("DUPLICATE", 365),
          "the close payload distinguishes which issue it duplicates")
    check(approvals.close_payload("NOT_PLANNED", None)
          != approvals.close_payload("COMPLETED", None),
          "the close payload distinguishes the state reason")
    check(approvals.labels_payload(["Core"], []) !=
          approvals.labels_payload([], ["Core"]),
          "adding a label and removing it are different approvals")
    check(approvals.labels_payload(["Core", "Engine"], []) ==
          approvals.labels_payload(["Engine", "Core"], []),
          "label order does not change the payload")

    check([w[:3] for w in approvals.missing(
              [("comment", 927, "927", body), ("close", 927, "", "x")], ledger)]
          == [("close", 927, "")],
          "missing() reports the close and not the comment already on file")

    # publish-verdicts asks for one approval per comment plus one for the close,
    # which is what makes "post the finding but leave it open" refusable on its
    # own.
    two = [({"issue": "927", "action": "close", "verdict": "duplicate",
             "dup": "364"}, [("927", body), ("927.2", "second")])]
    want = publish.wanted_approvals(two)
    check([(a, n, k) for a, n, k, _ in want]
          == [("comment", 927, "927"), ("comment", 927, "927.2"),
              ("close", 927, "")],
          "a two-comment close asks for three approvals", str(want))
    check(want[-1][3] == approvals.close_payload("DUPLICATE", 364),
          "the close approval carries the reason and the dup target")

    check("bin/approve" in approvals.refuse([("comment", 927, "927", body)]),
          "the refusal names the command that records an approval")

    # The authorizing-word check.  Every one of these is a real sentence from the
    # transcript, and the seventh failure went out under the first refusal case.
    grants = ["I approve.  Please apply and push",
              "I approve -- please apply/push",
              "I authorize you to apply and push",
              "you are authorized to apply",
              "I approve, no need to ask again"]
    refusals = ["Please use it for this batch for now",
                "Next batch please",
                "Ok, let's file both. But before we push, let's finish this file.",
                "When did I authorize --apply?",
                "Did I approve this?",
                "I did not approve that",
                "cannot approve", "I can't approve that", "won't approve",
                "I refuse to approve", "decline to authorize",
                "no need to approve", "I'm withholding approval",
                "couldn't approve that", "shouldn't approve"]
    check(all(approvals.authorizing(g)[0] for g in grants),
          "a real grant passes the authorizing check",
          str([g for g in grants if not approvals.authorizing(g)[0]]))
    check(not any(approvals.authorizing(r)[0] for r in refusals),
          "a paraphrase, question or denial does not",
          str([r for r in refusals if approvals.authorizing(r)[0]]))

    # --------------------------------------------- the fix project's four predicates
    #
    # Each of these was wrong on first writing and each was caught only by reading
    # the output against issues I already knew the answer for.  All four fail
    # silently: a mis-resolved path sends someone to the wrong file, and a
    # mis-scored axis just reorders a ranking nobody can check by eye.

    # index-files: a bare basename that ties with its own regression test must
    # resolve to the implementation.  Untiered, "ringmap.m2" tied with
    # tests/normal/ringmap.m2 and SEVEN issues silently left the index.
    suffixes = indexfiles.build_suffix_map([
        "M2/Macaulay2/m2/ringmap.m2", "M2/Macaulay2/tests/normal/ringmap.m2",
        "M2/Macaulay2/m2/matrix2.m2", "M2/Macaulay2/e/basic-rings/aring.cpp",
        "M2/Macaulay2/e/interface/aring.cpp"])
    check(indexfiles.resolve("ringmap.m2", suffixes)[0]
          == "M2/Macaulay2/m2/ringmap.m2",
          "a basename shared with a test resolves to the implementation")
    check(indexfiles.resolve("tests/normal/ringmap.m2", suffixes)[0]
          == "M2/Macaulay2/tests/normal/ringmap.m2",
          "naming the test path explicitly still reaches the test")
    # A genuine tie inside one tier must stay unresolved rather than pick one.
    check(indexfiles.resolve("aring.cpp", suffixes)[0] is None,
          "two implementation files with one basename stay ambiguous")
    # M2 reports Core scripts as "Core/matrix2.m2"; they live in m2/.
    check(indexfiles.resolve("Core/matrix2.m2", suffixes)[0]
          == "M2/Macaulay2/m2/matrix2.m2",
          "the Core/ path M2 prints resolves to the m2/ source")
    # "ZZ/101[a..d]" is a ring, not a file ending in .d.
    check(indexfiles.resolve("a..d", suffixes)[1] == "not-a-file",
          "a..d is a variable range, not an interpreter source")
    check([lines for _, lines in indexfiles.mentions("matrix2.m2:228-230 and :281")]
          == ["228-230"],
          "a line range is captured whole")

    # score: the negation guards.  Both directions, because the notes cancel a
    # severity word before it ("no longer segfaults") and after it ("a wrong
    # answer that can no longer occur") -- and a backwards-only guard scored the
    # second one 4, which is exactly upside down.
    dropped = collections.Counter()
    def sev(note):
        return scoring.severity({"note": note, "title": ""}, dropped)[1]
    check(sev("trim returns a strictly smaller ideal") == "wrong-answer",
          "an uncancelled wrong answer scores as one")
    check(sev("describes a wrong answer that can no longer occur") == "",
          "a severity word cancelled AFTER it does not count")
    check(sev("this no longer segfaults on the reporter's input") == "",
          "a severity word cancelled BEFORE it does not count")
    check(sev("rawLinAlgDeterminant segfaults and corrupts the heap") == "crash",
          "an uncancelled crash scores as one")

    # score: "unanswered" means a pending decision only when the triage did not
    # answer it.  #256's note reads "Answers mahrud's unanswered 2024 question",
    # and left in, this axis penalised a row for having been diagnosed well.
    def settled(note):
        return scoring.settled({"note": note, "title": "", "labels": "",
                                "verdict": "reproduces"})
    check(settled("Dan's 2020 follow-up 'we could do the same thing for method "
                  "functions' is also unanswered") == -2,
          "a genuinely pending question scores down")
    # ...and "design question" is the harder rule, so it outranks the softer one.
    check(settled("Dan's design question is unanswered, 0 comments in 11 years") == -3,
          "a pending question that is explicitly a design question scores -3")
    check(settled("Answers mahrud's unanswered 2024 question") == 0,
          "a question the triage answered does not")
    check(settled("built a case that separates the three candidate behaviors") == -3,
          "a disputed right answer scores down hardest")

    # cluster: the line-span bound.  Plain transitive closure over an 80-line
    # window walked matrix2.m2 from :10 to :358 and called the whole file one
    # group, which is the opposite of a shared fix site.
    index = {("f", "1"): "10", ("f", "2"): "80", ("f", "3"): "150",
             ("f", "4"): "220", ("f", "5"): "600"}
    check(clustering.span_of(["1", "4"], index, "f") == 210,
          "a group's span is measured end to end, not pairwise")
    check(clustering.near(clustering.lines_of("228-230"),
                          clustering.lines_of("281")),
          "the unsound code and the guard that misses it are one neighbourhood")
    check(not clustering.near(clustering.lines_of("10"),
                              clustering.lines_of("358")),
          "opposite ends of a long file are not")
    check(clustering.lines_of("228-230,281") == [(228, 230), (281, 281)],
          "a multi-pinpoint cell parses into both neighbourhoods")

    for f in failures:
        print("FAIL: %s" % f, file=sys.stderr)
    if failures:
        print("%d failure(s)" % len(failures), file=sys.stderr)
        return 1
    if verbose:
        print("all %d cases pass" % len(ran))
    return 0


if __name__ == "__main__":
    sys.exit(main())
