#!/usr/bin/env python3
"""Regression tests for the two predicates here that have shipped wrong.

Neither is complicated, and that is the point: both are one-line rules over text,
both looked obviously right, and both were wrong in a way no dry run showed until
something had already been published or recorded.

    project.ISSUE_REF   decides whether "#123" is an issue reference or M2 code.
                        Shipped matching only word characters before the "#", so
                        "(x+1)#0" was published as a link to issue 0 -- twice,
                        the second time live on the board for weeks.

    run-repros.truncated  decides whether a script stopped at an "end" line before
                        its real content.  Shipped as an exact match on "end", so
                        "end--" was invisible and eight reproducers were recorded
                        "pass" having run nothing.

Both lists below are drawn from files that actually exist in this catalog rather
than invented, and both carry the two error modes a predicate has: it must fire
when it should, and stay quiet when it shouldn't.

    bin/selftest        # silent on success, nonzero exit on failure
    bin/selftest -v     # print every case
"""

import importlib.machinery
import subprocess
import importlib.util
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))


# Paths for the ask-key round trip below.  Drawn from the catalog, and chosen for
# the characters that could plausibly break a split: dots, hyphens, digits, a
# subdirectory, and a name that already ends in a digit.
ASK_KEY_PATHS = [
    "bugs/dan/IDEAS",
    "bugs/dan/0-bugs-decker.m2",
    "bugs/mike/gbB-refactor-gb/gb-one-minute.m2",
    "bugs/mike/git-issue242-243-244.m2",
    "bugs/anton/NumericalAG/_numericalID_example.m2",
]


def load(name, filename):
    """Import a sibling script by path.

    The loader has to be given explicitly: the scripts here have no .py suffix,
    and spec_from_file_location returns None rather than raising when it cannot
    guess one, so the failure arrives later as 'NoneType has no attribute loader'.
    """
    path = os.path.join(HERE, filename)
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


project = load("project", "project.py")
runrepros = load("runrepros", "run-repros")
catalog = load("catalog", "catalog.py")
pushproject = load("pushproject", "push-project")

# ------------------------------------------------------- want_status on a split
#
# A wishlist file's card is Done once every ask in it is settled -- that is what
# "we have successfully triaged this file" means, and it is the only way those
# cards ever leave the board.  The condition first shipped as "the path appears
# in asks.tsv at all", which is a different claim: splitting a file is one edit
# and triaging its asks is a week's work, so the card would have announced itself
# triaged while every ask in it still said todo.  It made no difference at the
# time, because every ask then in the file was already settled -- which is
# exactly the state in which a wrong predicate leaves no trace.
#
# (row verdict, row issue, ask verdicts, expected status)
WANT_STATUS = [
    ("open", "#4640 #4641", ["open", "open"],          "Done"),
    ("fixed", "",           ["fixed", "wontfix"],      "Done"),
    ("todo", "",            ["fixed", "todo"],         "Backlog"),
    ("open", "#4644",       ["fixed", "todo"],         "In progress"),
    ("open", "",            ["todo"],                  "Ready"),
    ("open", "",            [],                        "Ready"),
    ("open", "#4644",       [],                        "In progress"),
    ("wontfix", "",         [],                        "Done"),
]

# ---------------------------------------------------------------- linkify

# (text, the reference that must come out as a link)
LINKED = [
    ("see #4610 for details", "#4610"),
    ("#36 opens the batch", "#36"),
    ("(#2130) is the closed one", "#2130"),
    ("PR #3748, merged 2026-03-17", "#3748"),
    ("closed as a duplicate of #101.", "#101"),
    ("Macaulay2/M2-emacs#102 is somebody else's", "Macaulay2/M2-emacs#102"),
]

# Text that must survive untouched.  Every one of these is M2 code.
NOT_LINKED = [
    "the fix applies it to v#0, the underlying matrix",
    "packages.m2:437 tests class sym#1 and reports nam",
    'commandLine#0 | " --help"',
    "the length is 1 and (x+1)#0 is the RawRingElement",
    'B := ((value getGlobalSymbol "fourierMotzkin") A)#0, replacing them',
    'value LLLBases.Dictionary#"LLL"',
    "peek gives R{x+1}, and {1,2,3}#2 is 3",
    "an array [1,2,3]#0 is 1",
]

# Already a markdown link: must survive untouched.  Linkifying these again gave
# "[[#4621](url)](url)" in four filed issues -- see the comment at ISSUE_REF.
ALREADY_LINKED = [
    "see [#4621](https://github.com/Macaulay2/M2/issues/4621) for the engine side",
    "[#150](https://github.com/Macaulay2/M2/issues/150) and [#4459](https://github.com/Macaulay2/M2/pull/4459)",
    "closes [#36](https://github.com/Macaulay2/M2/issues/36).",
]

# Known and accepted: "/" is excluded from the lookbehind, so in a
# slash-separated list only the first reference becomes a link.  Three notes
# spell one that way ("#4576/#4578/#4583", "#1061/#1067").  Left alone
# deliberately -- widening the class would start linkifying URL fragments.
KNOWN_UNLINKED = ["#4576/#4578/#4583 share a shape"]

# ---------------------------------------------------------------- truncated

# Lines that ARE an "end" statement and must stop the script.
END_LINES = [
    "end",
    "end--",
    "end;",
    "end -- paste the rest in by hand",
    "end;  -- and a comment too",
    "end -* block comment *-",
]

# Lines that merely start with those three letters and must not.
NOT_END_LINES = [
    "endPackage",
    'endPackage "Foo"',
    "endl",
    '<< "done" << endl',
    "ending = true",
    "end3 = 7",
]


# ---------------------------------------------------------------- key_of
#
# An ask's issue body says "triaged from one request inside `bugs/dan/IDEAS`",
# which project.TRIAGED_FROM matches.  by_key uses setdefault, so if the ask's
# issue reached that key before the file's own draft did, bin/push-project would
# rewrite the ask with the file-level layout and set its status from the file
# row.  The marker has to win, whatever the prose says.
ASK_BODIES = [
    "<!-- bug-triage-ask: bugs/dan/IDEAS::3 -->\n\ntriaged from `bugs/dan/IDEAS`",
    "<!--bug-triage-ask:bugs/dan/IDEAS::3-->\n\nTriaged from `bugs/dan/IDEAS`",
    "<!-- bug-triage-ask:  bugs/dan/IDEAS::3  -->\n\nno path prose at all",
]

# A file-level body must still resolve to its path, marker absent.
FILE_BODIES = [
    ("Triaged from `bugs/dan/IDEAS`; see #36.", "bugs/dan/IDEAS"),
    ("triaged from `bugs/mike/gbB-refactor-gb/master-f4`", "bugs/mike/gbB-refactor-gb/master-f4"),
    # The linked form, which issue bodies now use.  TRIAGED_FROM demanded a backtick
    # immediately after "from ", so this stopped matching and 108 issues silently
    # fell back to a title-derived key and went unmatched -- push-project could
    # never have updated them again.
    ("triaged from [`bugs/dan/IDEAS`](https://github.com/Macaulay2/M2/blob/abc/bugs/dan/IDEAS), one of",
     "bugs/dan/IDEAS"),
    ("This issue was triaged from [`bugs/mike/0-GF-division.m2`](https://x), one of the 857",
     "bugs/mike/0-GF-division.m2"),
]


def main():
    verbose = "-v" in sys.argv
    failures = []

    def check(ok, label, detail=""):
        if not ok:
            failures.append(label + (("  -> " + detail) if detail else ""))
        if verbose:
            print("%s  %s" % ("ok  " if ok else "FAIL", label))

    for text, ref in LINKED:
        out = project.linkify(text)
        check(("[%s](" % ref) in out, "link %s in %r" % (ref, text), out)
    for text in NOT_LINKED:
        out = project.linkify(text)
        check("/issues/" not in out, "no link in %r" % text, out)
    # A bug file link must point into Macaulay2/M2 at the pre-removal commit, not
    # into the fork's bug-triage/files/, which is gitignored and 404s.  Four filed
    # issues carried the dead form.  Also checks the sha is a full 40 characters:
    # an abbreviated one would work today and could go ambiguous later.
    u = project.file_url("bugs/dan/IDEAS")
    check(u.startswith("https://github.com/Macaulay2/M2/blob/"),
          "file_url points at the canonical repository", u)
    check(u.endswith("/bugs/dan/IDEAS"), "file_url keeps the catalog path", u)
    check("bug-triage/files" not in u, "file_url avoids the gitignored copy", u)
    check(len(project.REMOVAL_PARENT) == 40 and
          all(c in "0123456789abcdef" for c in project.REMOVAL_PARENT),
          "REMOVAL_PARENT is a full sha", project.REMOVAL_PARENT)
    # Shape is not enough now that ~180 published links depend on this commit.  If
    # history were ever rewritten past it they would all break at once, so check
    # the object is really here and really has the bugs/ tree under it.
    for probe in ("bugs/dan/IDEAS", "bugs/mike/0-GF-division.m2",
                  "bugs/gfurnish/TODO"):
        ok = subprocess.run(
            ["git", "cat-file", "-e", "%s:%s" % (project.REMOVAL_PARENT, probe)],
            cwd=HERE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        check(ok, "REMOVAL_PARENT still has %s" % probe)

    for text in ALREADY_LINKED:
        out = project.linkify(text)
        check(out == text, "already-linked text is untouched: %r" % text, out)
    for text in KNOWN_UNLINKED:
        if verbose:
            print("note  only the first is linked: %s" % project.linkify(text))

    for line in END_LINES:
        check(bool(runrepros.END_STATEMENT.match(line)), "end statement %r" % line)
    for line in NOT_END_LINES:
        check(not runrepros.END_STATEMENT.match(line), "not an end statement %r" % line)

    # bin/file-asks recovers a path from an ask key by splitting on the LAST
    # "::", and writes the resulting issue number onto that path's catalog row.
    # Get it wrong and an issue is recorded against the wrong file -- silently,
    # because every path here is real and by_path would not raise.  The rule is
    # sound only while no path contains "::", which is checked below against the
    # live catalog rather than assumed.
    for path in ASK_KEY_PATHS:
        key = catalog.ask_key({"path": path, "n": "7"})
        check(key.rsplit("::", 1)[0] == path, "ask key round-trips %r" % path, key)
        check(key.rsplit("::", 1)[1] == "7", "ask number survives %r" % path, key)
    live = [r["path"] for r in catalog.read() if "::" in r["path"]]
    check(not live, "no catalog path contains '::'", ", ".join(live[:3]))

    # The marker must beat the prose, and must not disturb file-level bodies.
    for body in ASK_BODIES:
        got = project.key_of({"content": {"body": body, "title": "a readable title"}})
        check(got == "bugs/dan/IDEAS::3", "ask marker wins over prose", repr(got))
    for body, want in FILE_BODIES:
        got = project.key_of({"content": {"body": body, "title": "a readable title"}})
        check(got == want, "file body still keys on %r" % want, repr(got))

    # An open item, so is_closed stays false and the tracker override never fires;
    # the closed-issue case is covered by the board's own "Item closed" workflow.
    item = {"content": {"state": "OPEN"}}
    for verdict, issue, ask_verdicts, want in WANT_STATUS:
        row = {"path": "bugs/dan/0-bugs-decker.m2", "verdict": verdict, "issue": issue}
        split = ({row["path"]: [{"n": str(i + 1), "verdict": v}
                                for i, v in enumerate(ask_verdicts)]}
                 if ask_verdicts else {})
        got = pushproject.want_status(row, item, split)
        check(got == want, "want_status(%s, %r asks) is %s" % (verdict, ask_verdicts, want), got)

    for f in failures:
        print("FAIL: %s" % f, file=sys.stderr)
    if failures:
        print("%d failure(s)" % len(failures), file=sys.stderr)
        return 1
    if verbose:
        n = (len(LINKED) + len(NOT_LINKED) + len(END_LINES) + len(NOT_END_LINES)
             + 2 * len(ASK_KEY_PATHS) + 1
             + len(ASK_BODIES) + len(FILE_BODIES) + len(ALREADY_LINKED)
             + len(WANT_STATUS) + 7)
        print("all %d cases pass" % n)
    return 0


if __name__ == "__main__":
    sys.exit(main())
