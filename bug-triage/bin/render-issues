#!/usr/bin/env python3
"""Render issues.tsv as ISSUES.md, so the sweep can be read without a TSV viewer.

Generated.  Edit issues.tsv, not the output.

Ordered oldest first throughout, because that is the order the sweep works in and
because age is the strongest prior in this corpus: a 2014 report against a system
that has had twelve years of releases is far more likely to be settled than a 2026
one, whichever way it settles.
"""

import argparse
import collections
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import issues as issuestsv
import project

HEADINGS = {
    "todo": "Not yet triaged",
    "reproduces": "Still broken -- the reported failure came back",
    "stands": "Still open -- read, and the ask is still unmet",
    "stale-repro": "Reproducer needs rewriting before it says anything",
    "not-reproducible": "No longer reproduces, cause unknown",
    "fixed": "Fixed",
    "duplicate": "Covered by an older issue",
    "not-a-bug": "Expected behavior",
    "wontfix": "Won't fix",
    "obsolete": "Obsolete",
    "needs-reporter": "Waiting on the reporter",
}

ORDER = ["todo", "reproduces", "stands", "stale-repro", "not-reproducible",
         "fixed", "duplicate", "not-a-bug", "wontfix", "obsolete",
         "needs-reporter"]

# What a "run" result is worth.  Kept next to the table it annotates rather than
# only in README-open-issues.md, because this column is the one a reader will over-trust.
RUN_MEANS = {
    "reproduces": "the recorded diagnostic came back",
    "same-output": "every recorded value is unchanged",
    "differs": "some value changed -- read it",
    "clean": "ran to completion, nothing recorded came back",
    "clean-partial": "an `end` line cut it short; almost nothing",
    "crash": "signal or internal error",
    "different-error": "failed, but not the recorded way",
    "drift": "failed on API drift",
    "missing-package": "the package would not load",
    "syntax": "the *extractor* failed; says nothing about the issue",
    "timeout": "still running at the limit",
    "n/a-platform": "this machine is not the platform in question",
    "n/a": "nothing runnable in the body",
    "": "not run",
}

linkify = project.linkify


def cell(text):
    return (text or "").replace("|", "\\|") or "&nbsp;"


def bar(count, total, width=28):
    filled = 0 if not total else round(width * count / total)
    return "`" + "#" * filled + "." * (width - filled) + "`"


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("-o", "--output",
                   default=os.path.join(issuestsv.ROOT, "ISSUES.md"))
    args = p.parse_args()

    rows = issuestsv.require(issuestsv.read())
    total = len(rows)
    verdicts = collections.Counter(r["verdict"] or "todo" for r in rows)
    runs = collections.Counter(r["run"] for r in rows)

    out = []

    def w(line=""):
        out.append(line)

    w("# The open issues of Macaulay2/M2")
    w("")
    w("Generated by `bin/render-issues`.  Do not edit -- edit `issues.tsv`.")
    w("")
    w("%d open issues, oldest first.  See [README-open-issues.md](README-open-issues.md) for what each "
      "verdict means and for why nothing here closes an issue on its own." % total)
    w("")

    w("## Where it stands")
    w("")
    for v in ORDER:
        if verdicts.get(v):
            w("- `%-16s` %-46s %4d  %s"
              % (v, HEADINGS[v], verdicts[v], bar(verdicts[v], total)))
    w("")

    w("### Reproducer runs")
    w("")
    w("`bin/extract-repros` pulls a script out of the issue body and "
      "`bin/run-issue-repros` runs it against a clean M2.  **This is a hint, not "
      "a verdict.**  Most of these issues report a wrong answer rather than a "
      "crash, so a run that completes says nothing on its own; what says "
      "something is whether the diagnostics or the values the reporter recorded "
      "came back.")
    w("")
    for r in sorted(runs, key=lambda k: -runs[k]):
        if not runs[r]:
            continue
        w("- `%-16s` %-52s %4d" % (r or "(none)", RUN_MEANS.get(r, ""), runs[r]))
    w("")

    labelled = sum(1 for r in rows if r["labels"])
    w("### Labels")
    w("")
    w("%d of %d carry at least one label; %d carry none."
      % (labelled, total, total - labelled))
    w("")

    for v in ORDER:
        group = [r for r in rows if (r["verdict"] or "todo") == v]
        if not group:
            continue
        w("## %s -- `%s` (%d)" % (HEADINGS[v], v, len(group)))
        w("")
        w("| issue | created | run | labels | note |")
        w("| --- | --- | --- | --- | --- |")
        for r in sorted(group, key=lambda r: int(r["issue"])):
            note = r["note"]
            if r["dup"]:
                note = ("duplicate of %s.  %s" % (r["dup"], note)).strip()
            w("| [#%s](%s/issues/%s) | %s | %s | %s | %s |"
              % (r["issue"], project.REPO_URL, r["issue"], r["created"],
                 cell(r["run"]), cell(r["labels"]), cell(linkify(note))))
        w("")

    with open(args.output, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")
    print("wrote %s: %d rows" % (args.output, total))


if __name__ == "__main__":
    main()
