#!/usr/bin/env python3
"""Build (or refresh) catalog.tsv from the files extracted by bin/extract.

Re-running is safe: rows are keyed on "path", and the human columns of an
existing row are carried over untouched.  Only the machine-generated metadata is
recomputed, and rows for newly appearing files are added.
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import catalog


def count_lines(path):
    with open(path, "rb") as f:
        return sum(1 for _ in f)


def walk():
    """Yield catalog paths, e.g. bugs/dan/0-decompose.m2, relative to files/."""
    for dirpath, _, filenames in os.walk(catalog.FILES):
        for name in filenames:
            full = os.path.join(dirpath, name)
            yield os.path.relpath(full, catalog.FILES), full


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--dry-run", action="store_true",
                   help="report what would change without writing")
    args = p.parse_args()

    if not os.path.isdir(catalog.FILES):
        raise SystemExit("no %s -- run bin/extract first" % catalog.FILES)

    existing = catalog.by_path(catalog.read())
    rows = []
    added = 0

    for path, full in walk():
        old = existing.get(path)
        row = {
            "path": path,
            "owner": catalog.owner_of(path),
            "prio": catalog.prio_of(path),
            "kind": catalog.kind_of(path),
            "lines": str(count_lines(full)),
            # autorun is owned by bin/run-repros; preserve whatever it recorded.
            "autorun": old["autorun"] if old else "",
        }
        for c in catalog.HUMAN:
            row[c] = old[c] if old else ""

        if old is None:
            added += 1
            # Anton filed these under RESOLVED/ himself, so they start settled.
            if "/RESOLVED/" in path:
                row["verdict"] = "fixed"
                row["note"] = ("author filed it under RESOLVED/; fix points at "
                               "that filing, not necessarily the code change")
            else:
                row["verdict"] = "todo"

        rows.append(row)

    gone = sorted(set(existing) - {r["path"] for r in rows})
    for path in gone:
        # Keep the row rather than dropping a hand-written verdict on the floor.
        rows.append(existing[path])
        print("warning: %s no longer in files/, row kept" % path, file=sys.stderr)

    if args.dry_run:
        print("would write %d rows (%d new, %d missing from files/)"
              % (len(rows), added, len(gone)))
        return

    catalog.write(rows)
    print("wrote %s: %d rows (%d new)" % (catalog.TSV, len(rows), added))


if __name__ == "__main__":
    main()
