#!/usr/bin/env python3
"""Set the GitHub issue type named in the "settype" column.

DRY RUN BY DEFAULT.

Issue types are a second taxonomy alongside labels: single-valued, org-level, and
on Macaulay2 they are Bug, Feature and Task.  They were splitting this corpus in
half before anyone noticed -- 93 open issues carried the type "Feature" and 130
others carried the "bug" or "feature request" *label*, with no overlap at all.

Derived, not recorded, exactly as bin/apply-labels is: the "type" column holds
what GitHub had at the last bin/init-issues, so a row whose type is already right
produces nothing and a type changed by hand is respected on the next refresh.

**--apply needs Doug's go-ahead for these issues, at that moment**, and is refused
without a matching row in approved.tsv -- run bin/approve type <N>... after he has
said yes.  A type appears on somebody else's issue under his account, next to the
title.  That it notifies nobody is not the question; whether it is his to
authorize is, and it is.  See README.md.

Retyping an issue that already has one is expected here rather than exceptional.
All 93 existing assignments were made in a single pass on 2025-05-13 under a
two-way reading -- everything that was not a defect became a Feature -- so a
C++ template reorganisation (#9) and an internal caching inconsistency (#252) are
both currently filed as "a request, idea, or new functionality".  Task is what
those want, and it had never been used.

    ./bin/apply-types                  # show the plan
    ./bin/apply-types --apply          # do it
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import approvals
import issues as issuestsv
import project

TYPES_QUERY = """
query($owner:String!, $name:String!) {
  repository(owner:$owner, name:$name) {
    issueTypes(first:20) { nodes { id name isEnabled } }
  }
}
"""

ISSUE_QUERY = """
query($owner:String!, $name:String!, $number:Int!) {
  repository(owner:$owner, name:$name) {
    issue(number:$number) { id number state issueType { name } }
  }
}
"""

SET_TYPE = """
mutation($id:ID!, $type:ID) {
  updateIssue(input:{id:$id, issueTypeId:$type}) {
    issue { number issueType { name } }
  }
}
"""


def repo_types():
    """name -> node id, for the types the repository has enabled."""
    data = project.gh(TYPES_QUERY, owner=project.ORG, name=project.REPO)
    return {n["name"]: n["id"]
            for n in data["data"]["repository"]["issueTypes"]["nodes"]
            if n["isEnabled"]}


def plan(rows, before=None, only=None):
    """Rows needing a type set, and rows that already carry one.

    The second list is why this returns a pair.  A row that was pre-typed in the
    2025-05-13 bulk pass and re-read without change looks, from here, exactly like a
    row nobody has opened -- both have an empty "settype".  Reporting only the work
    makes a batch of ten come out as "7 issue(s)", and the three that are missing are
    silently either confirmed or unexamined.  Naming them puts the arithmetic back
    where it can be checked.
    """
    out, kept = [], []
    for r in rows:
        n = int(r["issue"])
        if only and n not in only:
            continue
        if before and r["created"] >= before:
            continue
        want = r.get("settype", "")
        if not want or want == r.get("type", ""):
            # Only interesting once somebody has looked: an untriaged row without a
            # type is just work not yet done, not a type left deliberately alone.
            if r.get("type", "") and r.get("verdict", "todo") != "todo":
                kept.append((r, r.get("type", "")))
            continue
        out.append((r, r.get("type", "") or "(none)", want))
    return out, kept


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--apply", action="store_true",
                   help="actually set types (default: dry run)")
    p.add_argument("--before", metavar="YYYY-MM-DD",
                   help="only issues created before this date")
    p.add_argument("--only", type=int, nargs="*", metavar="N")
    args = p.parse_args()

    rows = issuestsv.require(issuestsv.read())
    work, kept = plan(rows, args.before, set(args.only or []))

    def report_kept():
        if not kept:
            return
        print("\n%d already typed, left as is:" % len(kept))
        for r, had in kept:
            print("  #%-6s %-8s  %s" % (r["issue"], had, r["note"][:56]))

    if not work:
        print("nothing to do -- no row has a settype differing from GitHub's")
        report_kept()
        return

    known = repo_types()
    missing = sorted({w for _, _, w in work if w not in known})
    if missing:
        raise SystemExit(
            "not an enabled issue type on %s/%s: %s\n\nEnabled:\n  %s"
            % (project.ORG, project.REPO, ", ".join(repr(m) for m in missing),
               "\n  ".join(sorted(known))))

    stale = []
    for r, _, want in work:
        have = set(issuestsv.labels_of(r, "labels"))
        going = set(issuestsv.labels_of(r, "rmlabels"))
        left = sorted((have & set(project.SUPERSEDED_BY_TYPE)) - going)
        if left:
            stale.append((r["issue"], left))
    if stale:
        print("warning: these are being typed but keep the label the type "
              "replaces --\n         put it in rmlabels and run bin/apply-labels:")
        for n, left in stale:
            print("           #%-6s %s" % (n, ", ".join(left)))
        print()

    changes = sum(1 for _, had, _ in work if had != "(none)")
    for r, had, want in work:
        print("#%-6s %-10s -> %-8s  %s"
              % (r["issue"], had, want, r["note"][:44]))
    print("\n%d issue(s): %d newly typed, %d retyped"
          % (len(work), len(work) - changes, changes))
    report_kept()

    wanted = [("type", int(r["issue"]), "", want) for r, _, want in work]
    if not args.apply:
        print("dry run -- rerun with --apply")
        unapproved = approvals.missing(wanted)
        if unapproved:
            print("\n%d not approved yet: %s"
                  % (len(unapproved),
                     ", ".join("#%s" % n for _, n, _, _ in unapproved)))
        return

    unapproved = approvals.missing(wanted)
    if unapproved:
        raise SystemExit(approvals.refuse(unapproved))

    touched = []
    for r, _, want in work:
        number = int(r["issue"])
        issue = project.gh(ISSUE_QUERY, owner=project.ORG, name=project.REPO,
                           number=number)["data"]["repository"]["issue"]
        if issue is None:
            print("#%d: no such issue, skipped" % number, file=sys.stderr)
            continue
        if issue["state"] != "OPEN":
            print("#%d: closed since the last fetch, skipped" % number,
                  file=sys.stderr)
            continue
        project.gh(SET_TYPE, id=issue["id"], type=known[want])
        touched.append(number)
        print("#%d -> %s" % (number, want))

    # Note the run, so bin/approve can tell a continuation of the
    # authorization in force from a new one.  See approvals.since_last_apply.
    approvals.record_applied("apply-types", touched)
    print("\nRun bin/init-issues to pull the new types back into the catalog.")


if __name__ == "__main__":
    main()
