#!/usr/bin/env python3
"""Cache every Macaulay2/M2 issue locally so matching can be done offline.

The search API allows only 30 requests a minute, which is far too little to look
up 857 bug files one at a time.  The core API allows 5000 an hour, and the whole
issue list is about 21 paginated requests, so fetch it once and match locally.

Pull requests are kept, flagged with "pull_request": true.  They used to be
dropped, on the theory that only issues answer "is this already tracked?".  That
was wrong twice in one batch: PR #3328 settled whether `intersect()` should
assume ZZ -- Mike Stillman said no, and it merged with `intersect` deliberately
left out -- and PR #3852 added the warning that answers `1-loadPackage`.  Neither
was findable here, and `1-list-of-ideals-of-R` was written up as `open` before
the maintainer pointed at #3328.  A decision recorded only in a PR discussion is
still a decision.

They come free: the issues endpoint returns both in the same response, so this
costs no extra requests.  bin/suggest-issues filters them out, since a PR is a
poor thing to hand somebody as "your row may already be tracked here"; duplicate
searches should include them.
"""

import argparse
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import catalog

REPO = "Macaulay2/M2"
KEEP = ["number", "title", "state", "created_at", "closed_at", "html_url"]


def fetch():
    p = subprocess.run(
        ["gh", "api", "--paginate",
         "repos/%s/issues?state=all&per_page=100" % REPO],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if p.returncode != 0:
        raise SystemExit("gh api failed:\n" + p.stderr.decode("utf-8", "replace"))

    # --paginate concatenates one JSON array per page, so parse them in sequence.
    decoder = json.JSONDecoder()
    text = p.stdout.decode("utf-8", "replace")
    issues, pos = [], 0
    while pos < len(text):
        while pos < len(text) and text[pos].isspace():
            pos += 1
        if pos >= len(text):
            break
        page, pos = decoder.raw_decode(text, pos)
        issues.extend(page)

    out = []
    for i in issues:
        row = {k: i.get(k) for k in KEEP}
        row["pull_request"] = "pull_request" in i
        row["labels"] = [l["name"] for l in i.get("labels", [])]
        # Generous cap: bin/suggest-issues needs to see a whole file listing to
        # recognize one, and truncating mid-listing would defeat that check.
        row["body"] = (i.get("body") or "")[:20000]
        out.append(row)
    return out


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--refresh", action="store_true",
                   help="refetch even if the cache already exists")
    args = p.parse_args()

    path = os.path.join(catalog.CACHE, "issues.json")
    if os.path.exists(path) and not args.refresh:
        with open(path, encoding="utf-8") as f:
            print("%s already has %d issues (use --refresh)"
                  % (path, len(json.load(f))))
        return

    issues = fetch()
    os.makedirs(catalog.CACHE, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(issues, f, indent=1)

    is_open = sum(1 for i in issues if i["state"] == "open")
    prs = sum(1 for i in issues if i["pull_request"])
    print("wrote %s: %d items (%d open, %d closed; %d issues, %d pull requests)"
          % (path, len(issues), is_open, len(issues) - is_open,
             len(issues) - prs, prs))


if __name__ == "__main__":
    main()
