#!/usr/bin/env python3
"""Change the title of an issue whose scope has moved.

DRY RUN BY DEFAULT.

Its own script rather than part of bin/apply-types, though both go through the
same updateIssue mutation, because retitling is the most visible thing this
directory does to somebody else's issue.  It changes what everyone watching sees,
what their mail threads no longer match, and what a bookmark resolves to.  Giving
it a separate command means it cannot ride along unnoticed in a batch of eight
type changes.

**--apply needs Doug's go-ahead for that issue, at that moment**, like a close
does, and is refused without a matching row in approved.tsv -- run bin/approve
title <N> after he has said yes.  The comment file this already insists on is a
separate requirement and does not stand in for the approval: writing an
explanation is something I do alone, and deciding a stranger's issue should be
renamed is not.

Only for a genuine change of scope, and always with a comment saying so.  #290
was the first: filed in 2015 as "bug in gb over ZZ ? (using custom ordering)",
the wrong answer it reported was fixed by *disallowing the input*, so what the
issue tracks now is the missing capability rather than the defect.  Its title
described a symptom nobody will ever see again.

Derived, not recorded, like everything else here: "title" is what GitHub had at
the last bin/init-issues, "settitle" is the proposal, and a row whose title
already matches produces nothing.
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import approvals
import issues as issuestsv
import project

ISSUE_QUERY = """
query($owner:String!, $name:String!, $number:Int!) {
  repository(owner:$owner, name:$name) {
    issue(number:$number) { id number state title }
  }
}
"""

SET_TITLE = """
mutation($id:ID!, $title:String!) {
  updateIssue(input:{id:$id, title:$title}) { issue { number title } }
}
"""


def plan(rows, only=None):
    out = []
    for r in rows:
        n = int(r["issue"])
        if only and n not in only:
            continue
        want = r.get("settitle", "").strip()
        if not want or want == r.get("title", "").strip():
            continue
        out.append((r, r.get("title", ""), want))
    return out


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--apply", action="store_true",
                   help="actually retitle (default: dry run)")
    p.add_argument("--only", type=int, nargs="*", metavar="N")
    args = p.parse_args()

    rows = issuestsv.require(issuestsv.read())
    work = plan(rows, set(args.only or []))
    if not work:
        print("nothing to do -- no row has a settitle differing from GitHub's")
        return

    missing = [r["issue"] for r, _, _ in work
               if not os.path.exists(os.path.join(issuestsv.COMMENTS,
                                                  "%s.md" % r["issue"]))]
    if missing:
        raise SystemExit(
            "no comment written for %s.\n\nA retitle without an explanation is "
            "somebody's issue changing under them\nwith no reason given.  Write "
            "comments/issues/<N>.md first."
            % ", ".join("#" + n for n in missing))

    for r, old, new in work:
        print("#%s" % r["issue"])
        print("   was: %s" % old)
        print("   now: %s" % new)
    print("\n%d issue(s) to retitle." % len(work))

    wanted = [("title", int(r["issue"]), "", new) for r, _, new in work]
    if not args.apply:
        print("dry run -- rerun with --apply")
        unapproved = approvals.missing(wanted)
        if unapproved:
            print("\n%d not approved yet: %s"
                  % (len(unapproved),
                     ", ".join("#%s" % n for _, n, _, _ in unapproved)))
        return

    unapproved = approvals.missing(wanted)
    if unapproved:
        raise SystemExit(approvals.refuse(unapproved))

    for r, _, new in work:
        number = int(r["issue"])
        issue = project.gh(ISSUE_QUERY, owner=project.ORG, name=project.REPO,
                           number=number)["data"]["repository"]["issue"]
        if issue is None:
            print("#%d: no such issue, skipped" % number, file=sys.stderr)
            continue
        project.gh(SET_TITLE, id=issue["id"], title=new)
        print("#%d retitled" % number)

    print("\nRun bin/init-issues to pull the new titles back into the catalog.")


if __name__ == "__main__":
    main()
