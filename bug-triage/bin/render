#!/usr/bin/env python3
"""Render catalog.tsv into CATALOG.md, the view meant for humans.

Regenerate after every batch of triage.  Nothing here is authoritative --
catalog.tsv is.
"""

import argparse
import collections
import datetime
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import catalog
import project

REPO = "https://github.com/Macaulay2/M2"
REMOVAL = "d2c8d278264348116ac4c1feeb95150699e3e11b"

HEADINGS = {
    "open": "Still broken",
    "stale-repro": "Reproducer needs rewriting before it says anything",
    "duplicate": "Already tracked by an open issue",
    "fixed": "Fixed",
    "wontfix": "Won't fix",
    "obsolete": "Obsolete",
    "todo": "Not yet triaged",
}

# Settled buckets first, todo last since it starts out holding almost everything.
ORDER = ["open", "stale-repro", "duplicate", "fixed", "wontfix", "obsolete", "todo"]

# Shared with bin/push-project rather than kept in step by hand.  It also handles
# GitHub's owner/repo#123 form, which the issue column needs for a row filed
# against another repository -- see project.FOREIGN_REF.
linkify = project.linkify


def cell(text):
    return (text or "").replace("|", "\\|") or "&nbsp;"


def sort_key(row):
    """Priority ascending, blank priority last, then path."""
    try:
        prio = float(row["prio"])
    except ValueError:
        prio = 99.0
    return (prio, row["path"])


def load_suggestions():
    """Top-scoring candidate issue per bug file, if bin/suggest-issues has run."""
    path = os.path.join(catalog.CACHE, "suggestions.tsv")
    best = {}
    if not os.path.exists(path):
        return best
    with open(path, encoding="utf-8") as f:
        next(f, None)
        for line in f:
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 7 or parts[1] != "1":
                continue
            bug, _, score, why, issue, state, title = parts[:7]
            best[bug] = (float(score), why, issue, state, title)
    return best


def bar(count, total, width=28):
    filled = 0 if not total else round(width * count / total)
    return "`" + "#" * filled + "." * (width - filled) + "`"


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("-o", "--output", default=os.path.join(catalog.ROOT, "CATALOG.md"))
    p.add_argument("--suggestions", action="store_true",
                   help="show the top candidate issue for untriaged rows")
    args = p.parse_args()

    rows = catalog.require(catalog.read())
    suggestions = load_suggestions() if args.suggestions else {}

    verdicts = collections.Counter(r["verdict"] or "todo" for r in rows)
    autoruns = collections.Counter(r["autorun"] or "(not run)" for r in rows)
    owners = collections.Counter(r["owner"] for r in rows)
    total = len(rows)
    settled = total - verdicts["todo"]

    out = []
    w = out.append

    w("# Catalog of the removed `bugs/` directory")
    w("")
    w("Generated by `bin/render` on %s. Do not edit -- edit `catalog.tsv`."
      % datetime.date.today().isoformat())
    w("")
    w("The %d files below were deleted by [`%s`](%s/commit/%s) (\"remove bugs "
      "directory\"). Each was a bug report or feature request in Macaulay2's "
      "pre-GitHub catalog. This tracks whether each one still applies, whether "
      "an issue already covers it, and what fixed it."
      % (total, REMOVAL[:10], REPO, REMOVAL))
    w("")
    w("Settling all of these is [#36](%s/issues/36)." % REPO)
    w("")

    w("## Progress")
    w("")
    w("**%d of %d triaged (%.1f%%)**" % (settled, total, 100.0 * settled / total))
    w("")
    w("| verdict | count | |")
    w("| --- | ---: | --- |")
    for v in ORDER:
        if verdicts.get(v):
            w("| `%s` -- %s | %d | %s |"
              % (v, HEADINGS[v], verdicts[v], bar(verdicts[v], total)))
    w("")

    w("### Reproducer runs")
    w("")
    w("`bin/run-repros` runs each `.m2` file under the installed M2 and records "
      "the exit status. **This is a hint, not a verdict.** These scripts are old "
      "enough that many now fail on API drift rather than on the bug they "
      "demonstrate (see `cache/stale-candidates.txt`), and `pass-partial` marks "
      "a script that exited 0 only because a bare `end` line stopped it before "
      "the interesting part.")
    w("")
    w("| autorun | count | |")
    w("| --- | ---: | --- |")
    meaning = {
        "pass": "ran to the end without error",
        "pass-partial": "exited 0, but an `end` line cut it short -- weak signal",
        "fail": "uncaught error or failed assert",
        "timeout": "still running at the time limit",
        "n/a": "prose, not a runnable script",
        "(not run)": "no result recorded yet",
    }
    for k in ["pass", "pass-partial", "fail", "timeout", "n/a", "(not run)"]:
        if autoruns.get(k):
            w("| `%s` | %d | %s |" % (k, autoruns[k], meaning[k]))
    w("")

    w("### By original author")
    w("")
    w("| directory | files | triaged |")
    w("| --- | ---: | ---: |")
    for owner, count in sorted(owners.items(), key=lambda p: -p[1]):
        done = sum(1 for r in rows
                   if r["owner"] == owner and r["verdict"] != "todo")
        w("| `bugs/%s` | %d | %d |" % (owner, count, done))
    w("")

    for v in ORDER:
        group = sorted((r for r in rows if (r["verdict"] or "todo") == v), key=sort_key)
        if not group:
            continue
        w("## %s -- `%s` (%d)" % (HEADINGS[v], v, len(group)))
        w("")

        if v == "todo":
            header = "| prio | file | kind | autorun |"
            sep = "| ---: | --- | --- | --- |"
            if suggestions:
                header += " candidate issue |"
                sep += " --- |"
            w(header)
            w(sep)
            for r in group:
                line = "| %s | `%s` | %s | %s |" % (
                    cell(r["prio"]), r["path"], r["kind"], cell(r["autorun"]))
                if suggestions:
                    hit = suggestions.get(r["path"])
                    # Only show matches where an issue names the file outright.
                    # Keyword-only leads belong in cache/suggestions.tsv, not here;
                    # in a table this long they read as conclusions.
                    if hit and hit[1] == "name":
                        line += " %s %s |" % (linkify(hit[2]), cell(hit[4][:70]))
                    else:
                        line += " &nbsp; |"
                w(line)
        else:
            w("| prio | file | issue | fix | disposition | note |")
            w("| ---: | --- | --- | --- | --- | --- |")
            for r in group:
                w("| %s | `%s` | %s | %s | %s | %s |" % (
                    cell(r["prio"]), r["path"], linkify(r["issue"]) or "&nbsp;",
                    linkify(r["fix"]) or "&nbsp;", cell(r["disposition"]),
                    cell(r["note"])))
        w("")

    with open(args.output, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")
    print("wrote %s (%d rows, %d triaged)" % (args.output, total, settled))


if __name__ == "__main__":
    main()
