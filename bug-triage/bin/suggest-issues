#!/usr/bin/env python3
"""Suggest which existing Macaulay2/M2 issues might already cover each bug file.

Runs entirely against cache/issues.json, so it costs no API calls and can be
rerun freely.  Output is cache/suggestions.tsv, a shortlist of up to three
candidates per untriaged bug -- this is what makes hand-triaging 857 files
tractable.

It is advisory.  It never writes the "issue" column; scoring keyword overlap
cannot tell "same bug" from "same subsystem".

It also greps M2/Macaulay2/tests/ for regression tests that name a bug file
outright (the convention at tests/normal/factory.m2:26).  Those hits are listed
in cache/already-tested.tsv and are near-proof that the bug was fixed.
"""

import argparse
import collections
import json
import math
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import catalog

WORD = re.compile(r"[a-zA-Z][a-zA-Z0-9]{2,}")

# A bugs/ path mentioned in an issue.  Used to spot issues that paste a bulk file
# listing rather than discussing one bug.
BUGPATH = re.compile(r"bugs/[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+")

# An issue naming more than this many bug files is doing a repo-wide sweep, not
# reporting one bug -- #3384 ("Windows carriage return characters") lists every
# CRLF file in the tree, and would otherwise look like a certain match for each
# of them.  An issue genuinely about one bug names one path, occasionally two.
LISTING_THRESHOLD = 2

# Words too common in this corpus to discriminate between issues.
STOP = set("""
the and for that with this from not but are was were has have had you your
should would could will can may might must does did doing done make makes made
when where which what who why how all any some none other same than then there
here into over under about after before again more most much many few less
M2 macaulay2 macaulay bug issue error fix fixed problem file files line lines
code test tests example examples output input result results version
""".split())


def tokens(text):
    return [w.lower() for w in WORD.findall(text) if w.lower() not in STOP]


def slug_of(path):
    """0-final-checks-before-distribution -> that string, minus prio and extension."""
    base = os.path.basename(path)
    base = re.sub(r"\.(m2|M2|txt|md|sing|output|c|cc|eml)$", "", base)
    return re.sub(r"^[0-9]+(?:\.[0-9]+)?-", "", base)


def load_issues():
    path = os.path.join(catalog.CACHE, "issues.json")
    if not os.path.exists(path):
        raise SystemExit("no %s -- run bin/fetch-issues first" % path)
    with open(path, encoding="utf-8") as f:
        items = json.load(f)
    # The cache holds pull requests too, since decisions get made in their
    # discussions and duplicate searches need to see them.  Shortlisting is a
    # different job: "your row may already be tracked at #N" wants an issue, so
    # drop PRs here.  Older caches have no flag; treat those items as issues.
    return [i for i in items if not i.get("pull_request")]


def build_index(issues):
    """Per-issue token sets plus inverse document frequency over all issues."""
    docs = []
    df = collections.Counter()
    for i in issues:
        title = set(tokens(i["title"]))
        body = set(tokens(i["body"]))
        text = i["title"] + "\n" + i["body"]
        listing = len(set(BUGPATH.findall(text))) > LISTING_THRESHOLD
        docs.append((i, title, body, listing))
        for t in title | body:
            df[t] += 1
    n = len(issues)
    idf = {t: math.log(n / (1 + c)) for t, c in df.items()}
    return docs, idf


NAME_BONUS = 1000.0


def score(query, docs, idf, slug, basename):
    """Rank issues against a weighted query token bag.

    Returns (score, issue, why), where why distinguishes an issue that names the
    bug file outright from one that merely shares vocabulary.  Keeping them
    apart matters: the first is near-certain, the second is a lead at best.
    """
    ranked = []
    for issue, title, body, listing in docs:
        s = 0.0
        for t, weight in query.items():
            if t in title:
                s += weight * idf.get(t, 0.0) * 3.0
            elif t in body:
                s += weight * idf.get(t, 0.0)
        if s <= 0:
            continue
        # This is what finds #248 for 0-final-check-interactive-input-behaviour.
        haystack = issue["title"] + "\n" + issue["body"]
        named = (not listing
                 and (basename in haystack or (len(slug) > 8 and slug in haystack)))
        if named:
            s += NAME_BONUS
        ranked.append((s, issue, "name" if named else "keywords"))
    ranked.sort(key=lambda p: (-p[0], p[1]["number"]))
    return ranked


def grep_tests(rows):
    """Find regression tests that reference a bug file by its old bugs/ path."""
    repo = os.path.dirname(catalog.ROOT)
    tests = os.path.join(repo, "M2", "Macaulay2", "tests")
    if not os.path.isdir(tests):
        return []
    p = subprocess.run(
        ["grep", "-rn", "-e", "bugs/dan", "-e", "bugs/mike", "-e", "bugs/anton",
         "-e", "bugs/LAcore", tests],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    hits = []
    lines = p.stdout.decode("utf-8", "replace").splitlines()
    for r in rows:
        stem = re.sub(r"\.m2$", "", r["path"])
        # Anchor the tail so bugs/dan/1-factor does not match bugs/dan/1-factory-bug.
        pattern = re.compile(re.escape(stem) + r"(?![-\w.])")
        for line in lines:
            if pattern.search(line):
                where, _, text = line.partition(":")
                hits.append((r["path"], os.path.relpath(where, repo), text.strip()))
    return hits


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--top", type=int, default=3,
                   help="candidates per bug file (default: 3)")
    p.add_argument("--all", action="store_true",
                   help="include rows that already have a verdict")
    p.add_argument("--open-only", action="store_true",
                   help="only consider issues that are still open")
    args = p.parse_args()

    rows = catalog.require(catalog.read())
    issues = load_issues()
    if args.open_only:
        issues = [i for i in issues if i["state"] == "open"]
    docs, idf = build_index(issues)

    wanted = [r for r in rows if args.all or r["verdict"] == "todo"]
    out = os.path.join(catalog.CACHE, "suggestions.tsv")
    os.makedirs(catalog.CACHE, exist_ok=True)

    with open(out, "w", encoding="utf-8") as f:
        f.write("path\trank\tscore\twhy\tissue\tstate\ttitle\n")
        for r in wanted:
            path = r["path"]
            slug = slug_of(path)
            basename = os.path.basename(path)

            query = collections.Counter()
            # The filename slug is the author's own one-line summary; trust it most.
            for t in tokens(slug.replace("-", " ").replace("_", " ")):
                query[t] += 5.0
            try:
                with open(os.path.join(catalog.FILES, path),
                          encoding="utf-8", errors="replace") as bf:
                    body = bf.read(20000)
            except OSError:
                body = ""
            # Body words are noisy, so let only the recurring ones contribute.
            for t, c in collections.Counter(tokens(body)).most_common(25):
                if c > 1:
                    query[t] += 1.0

            if not query:
                continue
            for rank, (s, issue, why) in enumerate(
                    score(query, docs, idf, slug, basename)[:args.top], 1):
                f.write("%s\t%d\t%.1f\t%s\t#%d\t%s\t%s\n" % (
                    path, rank, s, why, issue["number"], issue["state"],
                    issue["title"].replace("\t", " ")))

    print("wrote %s for %d bug files" % (out, len(wanted)))

    hits = grep_tests(rows)
    tested = os.path.join(catalog.CACHE, "already-tested.tsv")
    with open(tested, "w", encoding="utf-8") as f:
        f.write("path\ttest\tline\n")
        for path, where, text in sorted(set(hits)):
            f.write("%s\t%s\t%s\n" % (path, where, text.replace("\t", " ")))
    print("wrote %s: %d bug files already named by a regression test"
          % (tested, len(set(h[0] for h in hits))))


if __name__ == "__main__":
    main()
