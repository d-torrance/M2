#!/usr/bin/env python3
"""Post the comments we have written, and close what we have agreed to close.

DRY RUN BY DEFAULT.

Two actions, one code path, because they share everything that matters -- the
attribution, the provenance footer, the marker that makes a rerun edit rather than
duplicate:

    action == "comment"   post the comment, leave the issue open
    action == "close"     post the comment, then close

Gates.  A comment needs a hand-written comments/issues/<N>.md and nothing else.  A
close needs all three of:

    1  verdict is in issues.CLOSABLE
    2  action == "close"
    3  that same comment file

bin/comment-issues treated the comment as optional, because there the question was
whether a comment added anything to somebody else's live issue.  Here the comment
*is* the close: an issue that shuts with no visible reason is what makes a triage
sweep read as a bot run, and it is what gets the whole sweep reverted by a
maintainer who cannot tell which of the closes were thought about.  So this script
refuses to close an issue it cannot explain.

An issue that stays open can still be worth a comment.  #72 is the case that
prompted this: the behaviour should not change after twenty years, but the naming
history and the alternatives to `decompose` are worth recording where whoever
updates the documentation will find them.  That is `action = comment` -- a verdict
of `stands` and a note to a stranger, with no close attached.

Verdict and action are separate columns on purpose.  "fixed" is a finding about
M2; "close" is a decision about somebody else's issue, and the decision does not
follow from the finding -- a `wontfix` may deserve to stay open under discussion,
and a `not-reproducible` on a platform we cannot test is not ours to shut.  Nothing
here infers one from the other.

**Comment first, then close.**  If the comment fails, the issue stays open.  A
close notification arriving with no visible reason is exactly the thing to avoid,
and doing it in this order means the failure mode is a comment with no close, which
is harmless and obvious.

Duplicates use GitHub's own relationship -- stateReason DUPLICATE with
duplicateIssueId -- rather than a hand-written cross-reference, so both issues
render "duplicate of #N" natively.  The `dup` column names the *older* issue, and
bin/issues.py re-checks that on every write; the older one survives.  A comment on
the older issue is still worth writing, because otherwise its watchers never learn
a second report existed, and that goes in comments/issues/<older>.md as its own row.

    ./bin/publish-verdicts            # show the exact text of every comment
    ./bin/publish-verdicts --apply    # post, and close where action = close
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import issues as issuestsv
import project

# Which reason GitHub records.  "not planned" is the honest one for everything we
# are declining rather than fixing; "completed" claims the thing asked for
# happened, which for not-reproducible is a claim about the world rather than
# about us, and the comment has to say the cause is unknown and invite reopening.
STATE_REASON = {
    "fixed": "COMPLETED",
    "not-reproducible": "COMPLETED",
    "duplicate": "DUPLICATE",
    "not-a-bug": "NOT_PLANNED",
    "wontfix": "NOT_PLANNED",
    "obsolete": "NOT_PLANNED",
}

ISSUE_QUERY = """
query($owner:String!, $name:String!, $number:Int!) {
  repository(owner:$owner, name:$name) {
    issue(number:$number) {
      id number state title
      issueType { name }
      labels(first:50) { nodes { name } }
      comments(first:100) { nodes { id body } }
    }
  }
}
"""

ADD_COMMENT = """
mutation($subject:ID!, $body:String!) {
  addComment(input:{subjectId:$subject, body:$body}) {
    commentEdge { node { url } }
  }
}
"""

UPDATE_COMMENT = """
mutation($id:ID!, $body:String!) {
  updateIssueComment(input:{id:$id, body:$body}) { issueComment { url } }
}
"""

# isSuggestion is deliberately not passed.  It files the close as a suggestion for
# somebody else to act on rather than performing it, and this script should either
# close an issue or leave it alone.
CLOSE = """
mutation($id:ID!, $reason:IssueClosedStateReason!, $dup:ID) {
  closeIssue(input:{issueId:$id, stateReason:$reason, duplicateIssueId:$dup}) {
    issue { number url stateReason }
  }
}
"""


def marker_for(key):
    """key is "290" or "290.2" -- one marker per comment, not per issue.

    A correction has to be able to sit *below* the thing it corrects.  Editing the
    original in place, which is what a single per-issue marker forces, produces a
    comment apologising for a claim that is no longer visible anywhere -- and
    quietly rewriting a published claim is the wrong instinct besides.  The marker
    exists to stop accidental re-posting, not to forbid a deliberate second
    comment, so it carries the sequence number.
    """
    return "<!-- issue-triage:%s -->" % key


def comment_files(number):
    """[(key, path)] for one issue: <N>.md, then <N>.2.md, <N>.3.md, ... in order.

    Numbered rather than dated so the order is explicit in the filename and a
    correction cannot be posted before the thing it corrects.
    """
    out = []
    first = os.path.join(issuestsv.COMMENTS, "%s.md" % number)
    if os.path.exists(first):
        out.append((str(number), first))
    n = 2
    while True:
        key = "%s.%d" % (number, n)
        path = os.path.join(issuestsv.COMMENTS, "%s.md" % key)
        if not os.path.exists(path):
            break
        out.append((key, path))
        n += 1
    return out


def comment_file(number):
    return os.path.join(issuestsv.COMMENTS, "%s.md" % number)


def bodies_for(row):
    """[(key, body)] for every comment written for this issue, in order."""
    number = int(row["issue"])
    out = []
    for key, path in comment_files(number):
        with open(path, encoding="utf-8") as f:
            text = f.read().strip()
        if text:
            out.append((key, build_body(number, key, text)))
    return out


def build_body(number, key, text):

    # Attribution first, above the text, never in a footer.  A disclosure placed
    # after the content is read after the content, which is too late to be the
    # thing it exists to be.  See "Put the attribution above the text" in
    # README-bugs-directory.md.
    parts = [project.ATTRIBUTION, "", text, "",
             "<sub>Triaged in a sweep of the open issues; source of truth: "
             "[`bug-triage/issues.tsv`](%s).</sub>" % ISSUES_URL,
             "", marker_for(key)]
    return "\n".join(parts)


ISSUES_URL = ("https://github.com/d-torrance/M2/blob/bug-triage"
              "/bug-triage/issues.tsv")


def plan(rows, only=None):
    out, missing = [], []
    by_number = issuestsv.by_number(rows)
    for r in rows:
        n = int(r["issue"])
        if only and n not in only:
            continue
        if r["action"] not in ("close", "comment"):
            continue
        if r["action"] == "close":
            if r["verdict"] not in issuestsv.CLOSABLE:
                raise SystemExit(
                    "#%s says action=close but verdict=%r, which is not a verdict "
                    "that closes anything" % (r["issue"], r["verdict"]))
            if r["verdict"] == "duplicate" and not r["dup"]:
                raise SystemExit("#%s is a duplicate of nothing -- fill in dup"
                                 % r["issue"])
        bodies = bodies_for(r)
        if not bodies:
            missing.append(n)
            continue
        out.append((r, bodies))
    if missing:
        raise SystemExit(
            "no comment written for %s.\n\nEvery close needs one: an issue that "
            "shuts with no visible reason is\nindistinguishable from a bot run.  "
            "Write %s"
            % (", ".join("#%d" % n for n in missing),
               ", ".join(comment_file(n) for n in missing)))
    return out


def pending_annotations(row, issue):
    """Which of this row's settype/addlabels have not reached GitHub yet.

    apply-types and apply-labels both refuse to touch a closed issue, on the
    theory that somebody else closed it and it is no longer ours to annotate.
    That guard cannot tell their close from ours, so closing first silently
    strips the type and labels off every issue in the batch -- which is what
    happened to #603, #604 and #606, and had to be repaired by hand afterwards.
    """
    pending = []
    if row["settype"] and row["settype"] != (issue["issueType"] or {}).get("name"):
        pending.append("type %s" % row["settype"])
    have = {n["name"] for n in issue["labels"]["nodes"]}
    missing = [l for l in issuestsv.labels_of(row, "addlabels") if l not in have]
    if missing:
        pending.append("label(s) " + ", ".join(missing))
    return pending


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--apply", action="store_true",
                   help="actually comment and close (default: dry run)")
    p.add_argument("--only", type=int, nargs="*", metavar="N",
                   help="only these issue numbers")
    p.add_argument("--max", type=int, default=10,
                   help="refuse to act on more than this many at once "
                        "(default: 10)")
    args = p.parse_args()

    rows = issuestsv.require(issuestsv.read())
    work = plan(rows, set(args.only or []))
    if not work:
        print("nothing to publish -- no row has action=comment or action=close")
        return
    if len(work) > args.max:
        raise SystemExit(
            "%d issues would be posted to, over the --max of %d.  These land in "
            "strangers'\ninboxes and cannot be taken back quietly; do them in "
            "batches." % (len(work), args.max))

    closes = 0
    for r, bodies in work:
        dup = issuestsv.dup_number(r)
        print("=" * 72)
        if r["action"] == "close":
            closes += 1
            print("#%s  %s -> close, %s%s"
                  % (r["issue"], r["verdict"], STATE_REASON[r["verdict"]],
                     "  (duplicate of #%d)" % dup if dup else ""))
        else:
            print("#%s  %s -> comment only, issue stays open"
                  % (r["issue"], r["verdict"]))
        if len(bodies) > 1:
            print("%d comments: %s" % (len(bodies),
                                       ", ".join(k for k, _ in bodies)))
        print("=" * 72)
        for key, body in bodies:
            print(body)
            print()

    print("%d issue(s): %d comment-only, %d comment then close."
          % (len(work), len(work) - closes, closes))
    if not args.apply:
        print("dry run -- rerun with --apply")
        return

    for r, bodies in work:
        number = int(r["issue"])
        issue = project.gh(ISSUE_QUERY, owner=project.ORG, name=project.REPO,
                           number=number)["data"]["repository"]["issue"]
        if issue is None:
            print("#%d: no such issue, skipped" % number, file=sys.stderr)
            continue
        if issue["state"] != "OPEN":
            print("#%d: already closed, skipped" % number, file=sys.stderr)
            continue

        # apply-types and apply-labels both refuse to touch a closed issue, on
        # the theory that somebody else closed it and it is no longer ours to
        # annotate.  That guard cannot tell their close from ours, so closing
        # first silently strips the type and labels off every issue in the
        # batch -- which is what happened to #603, #604 and #606, and had to be
        # repaired by hand afterwards.  Refuse the close instead of racing it.
        if r["action"] == "close":
            pending = pending_annotations(r, issue)
            if pending:
                print("#%d: not closing -- %s still unapplied.  Run "
                      "bin/apply-types --apply and bin/apply-labels --apply "
                      "first; they skip closed issues, so closing now would "
                      "lose them." % (number, "; ".join(pending)),
                      file=sys.stderr)
                continue

        # Idempotent per comment, not per issue: rerunning edits each keyed
        # comment already there and appends only the ones that are new, so a
        # follow-up lands below the comment it follows rather than replacing it.
        for key, body in bodies:
            marker = marker_for(key)
            existing = next((c for c in issue["comments"]["nodes"]
                             if marker in (c["body"] or "")), None)
            if existing:
                project.gh(UPDATE_COMMENT, id=existing["id"], body=body)
            else:
                project.gh(ADD_COMMENT, subject=issue["id"], body=body)

        if r["action"] != "close":
            print("#%d commented, left open" % number)
            continue

        dup = issuestsv.dup_number(r)
        dup_id = None
        if dup is not None:
            other = project.gh(ISSUE_QUERY, owner=project.ORG, name=project.REPO,
                               number=dup)["data"]["repository"]["issue"]
            if other is None:
                print("#%d: dup #%d does not exist, left open"
                      % (number, dup), file=sys.stderr)
                continue
            dup_id = other["id"]

        project.gh(CLOSE, id=issue["id"],
                   reason=STATE_REASON[r["verdict"]], dup=dup_id)
        print("#%d closed (%s)" % (number, STATE_REASON[r["verdict"]]))

    print("\nRun bin/init-issues to drop the closed rows from the catalog.")


if __name__ == "__main__":
    main()
