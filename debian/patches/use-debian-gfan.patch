Description: Use Debian gfan package instead of gfan shipped with M2.
Author: Doug Torrance <dtorrance@piedmont.edu>
Last-Update: 2020-05-05

--- a/M2/Macaulay2/packages/gfanInterface.m2
+++ b/M2/Macaulay2/packages/gfanInterface.m2
@@ -13,7 +13,7 @@
 	    {Name => "Diane Maclagan (current maintainer)", Email => "D.Maclagan@warwick.ac.uk", HomePage=>"http://homepages.warwick.ac.uk/staff/D.Maclagan/"}},
 	Headline => "interface to Anders Jensen's Gfan software",
 	Configuration => {
-		"path" => "",
+		"path" => "/usr/bin/",
 		"fig2devpath" => "",
 		"keepfiles" => true,
 		"verbose" => false,
--- a/M2/Macaulay2/packages/StatePolytope.m2
+++ b/M2/Macaulay2/packages/StatePolytope.m2
@@ -9,7 +9,7 @@
     	Headline => "the state polytope of an ideal",
 	-- DebuggingMode should be true while developing a package, 
 	--   but false after it is done
-	Configuration => {"gfan command" => "gfan"},
+	Configuration => {"gfan command" => "/usr/bin/gfan"},
     	DebuggingMode => false,
 	AuxiliaryFiles => true,
 	CacheExampleOutput => true
--- a/M2/configure.ac
+++ b/M2/configure.ac
@@ -981,14 +981,7 @@
 
 AC_MSG_CHECKING(whether the package gfan is installed)
 if test "`type -t gfan`" = file
-then AC_MSG_RESULT([yes, will build anyway])
-     dnl currently the gfanInterface package doesn't know how to find gfan if we don't build it.
-     dnl see https://github.com/Macaulay2/M2/pull/1123
-     dnl Also our *.dmg and *.deb making procedures need to know how to include it or set the dependencies appropriately
-     BUILD_gfan=yes
-     dnl we'll also build cddlib until gfan can find its files in /usr/include instead of in /usr/include/cdd
-     BUILD_cddlib=yes
-     BUILD_ALWAYS="$BUILD_ALWAYS gfan cddlib"
+then AC_MSG_RESULT([yes])
 else AC_MSG_RESULT([no, will build])
      BUILD_gfan=yes
 fi
