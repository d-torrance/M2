Description: Use Debian nauty package instead of nauty shipped with M2.
Author: Doug Torrance <dtorrance@piedmont.edu>
Last-Update: 2016-04-11

--- a/M2/Macaulay2/packages/Nauty.m2
+++ b/M2/Macaulay2/packages/Nauty.m2
@@ -14,7 +14,7 @@
                  Email => "dwcook@eiu.edu",
                  HomePage => "http://ux1.eiu.edu/~dwcook/"}},
     Headline => "interface to nauty",
-    Configuration => {"path" => ""},
+    Configuration => {"path" => "/usr/bin/nauty-"},
     PackageExports => {"EdgeIdeals"},
     DebuggingMode => false,
     Certification => {
--- a/M2/Macaulay2/packages/NautyGraphs.m2
+++ b/M2/Macaulay2/packages/NautyGraphs.m2
@@ -20,7 +20,7 @@
                  Email => "dcook8@nd.edu",
                  HomePage => "http://www.nd.edu/~dcook8"}},
     Headline => "interface to nauty (Graphs fork)",
-    Configuration => {"path" => ""},
+    Configuration => {"path" => "/usr/bin/nauty-"},
     PackageExports => {"Graphs"},
     DebuggingMode => false,
 ), x -> x =!= null)
--- a/M2/configure.ac
+++ b/M2/configure.ac
@@ -963,9 +963,7 @@
 
 AC_MSG_CHECKING(whether the package nauty is installed)
 if test "`type -t nauty-complg`" = file
-then AC_MSG_RESULT([yes, will build anyway])
-     dnl because the package Nauty doesn't look for it on the PATH
-     BUILD_nauty=yes
+then AC_MSG_RESULT([yes])
 else AC_MSG_RESULT([no, will build])
      BUILD_nauty=yes
 fi
