Description: Find git description during configure
 Since we won't have git installed, this will just give us "unknown".
Origin: https://github.com/Macaulay2/M2/commit/46795ba
Last-Update: 2016-04-05

--- a/M2/Macaulay2/d/Makefile.in
+++ b/M2/Macaulay2/d/Makefile.in
@@ -91,9 +91,7 @@
 ## the problem with this is that it can make "make" think the targets were made:
 # actors4-tmp.c actors5-tmp.c basic-tmp.c interface-tmp.c interface2-tmp.c objects-tmp.c : ../e/engine.h ../e/rand.h
 
-version.o : ../../include/M2/config.h git-description.c
-git-description.c: git-description; echo "const char * gitDescription = \"`cat $<`\";" >$@
-git-description: .; (git describe --dirty --long --always --abbrev=40 --tags --match 'version-*' || echo unknown) > $@
+version.o : ../../include/M2/config.h
 
 # these files depend on USE_MYSQL, which is in config.h:
 actors4.o actors2.o : ../../include/M2/config.h
--- a/M2/configure.ac
+++ b/M2/configure.ac
@@ -630,6 +630,10 @@
      fi
 fi
 
+AC_SUBST(GIT_DESCRIPTION)
+GIT_DESCRIPTION=`git describe --dirty --long --always --abbrev=40 --tags --match 'version-*' || echo unknown`
+AC_DEFINE_UNQUOTED(GIT_DESCRIPTION,"$GIT_DESCRIPTION",[summary of git status])
+
 AC_SUBST(DEB,no)
 AC_ARG_ENABLE(deb,  AS_HELP_STRING(--enable-deb,prepare a *.deb package (for debian, ubuntu, ...)), DEB=$enableval)
 if test "$DEB" = yes 
@@ -1639,6 +1643,7 @@
 AC_MSG_NOTICE([with  ARCH              = $ARCH])
 AC_MSG_NOTICE([with  OPTIMIZE          = $OPTIMIZE])
 AC_MSG_NOTICE([with  DEBUG             = $DEBUG])
+AC_MSG_NOTICE([with  GIT_DESCRIPTION   = $GIT_DESCRIPTION])
 
 function subset {
     # whether the words of $1 are among the words of $2
--- a/M2/Macaulay2/d/version.dd
+++ b/M2/Macaulay2/d/version.dd
@@ -33,7 +33,6 @@
    #define stringize(a) stringize0(a)
    #define Matrix FactoryMatrix
    #include <factory/factory.h>
-   #include \"git-description.c\"
    #undef Matrix
    extern char timestamp[];
    #undef ASSERT
@@ -228,7 +227,7 @@
    "build" => Ccode(constcharstar,"buildsystemtype"),
    "host" => Ccode(constcharstar,"hostsystemtype"),
    "threads" => USE_THREADS,
-   "git description" => Ccode(constcharstar,"gitDescription")
+   "git description" => Ccode(constcharstar,"GIT_DESCRIPTION")
    ))));
 
