Description: Get git description.
 Since we don't build in a git repository, we hardcode the git description.
 .
 For future upstream releases, update this patch using the desciption obtained by running
     git describe --dirty --long --always --abbrev=40 --tags --match 'version-*'
 after checking out the corresponding commit, e.g., "git checkout upstream/$version".
Author: Doug Torrance <dtorrance@piedmont.edu>
Last-Update: 2016-03-03

--- a/M2/Macaulay2/d/Makefile.in
+++ b/M2/Macaulay2/d/Makefile.in
@@ -92,8 +92,8 @@
 # actors4-tmp.c actors5-tmp.c basic-tmp.c interface-tmp.c interface2-tmp.c objects-tmp.c : ../e/engine.h ../e/rand.h
 
 version.o : ../../include/M2/config.h git-description.c
-git-description.c: git-description; echo "const char * gitDescription = \"`cat $<`\";" >$@
-git-description: .; (git describe --dirty --long --always --abbrev=40 --tags --match 'version-*' || echo unknown) > $@
+git-description.c:
+	echo "const char * gitDescription = \"version-1.8.2.1-0-gc579b9f9a2cf00825a3a0f66f4c410e5147d7a40\";" >$@
 
 # these files depend on USE_MYSQL, which is in config.h:
 actors4.o actors2.o : ../../include/M2/config.h
