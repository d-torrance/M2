Description: Fixes for building highlight.js.
 - Don't run "npm install" since no network access during build.
 - Use "highlight" instead of "core" highlight.js library; this was the name
   prior to webpack 10, but webpack 9 is still in sid.
Author: Doug Torrance <dtorrance@debian.org>
Forwarded: not-needed
Last-Update: 2022-02-25 

--- a/M2/Macaulay2/editors/Makefile.in
+++ b/M2/Macaulay2/editors/Makefile.in
@@ -32,7 +32,7 @@
 	$(CURDIR)/highlightjs/webpack.config.js    \
 	$(CURDIR)/highlightjs/index.js             \
 	$(CURDIR)/highlightjs/highlight-override.css
-	cd $(dir $@) && $ @NPM@ install && @NPM@ run build
+	cd $(dir $@) && $ @NPM@ run build
 endif
 
 clean::; rm -rf @pre_emacsdir@/* atom emacs highlightjs prism pygments vim
--- a/M2/Macaulay2/editors/highlightjs/index.js
+++ b/M2/Macaulay2/editors/highlightjs/index.js
@@ -1,4 +1,4 @@
-import hljs from 'highlight.js/lib/core';
+import hljs from 'highlight.js/lib/highlight';
 import macaulay2 from './macaulay2.js';
 import 'highlight.js/styles/default.css';
 import './highlight-override.css';
