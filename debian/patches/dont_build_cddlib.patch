Description:  Don't try and build cddlib.
 Upstream always builds it against built mpir, but we want to use the Debian
 package.
 Also look for header in /usr/include/cdd/.
Author: Doug Torrance <dtorrance@piedmont.edu>
Last-Update: 2020-05-01

--- a/M2/configure.ac
+++ b/M2/configure.ac
@@ -905,13 +905,8 @@
 then BUILTLIBS="-lgivaro $BUILTLIBS"
 fi
 
-AC_LANG(C)
-dnl topcom includes setoper.h, rather than cdd/setoper.h, so we do, too
-AC_CHECK_HEADER(setoper.h,,BUILD_cddlib=yes)
-if test $BUILD_cddlib = yes
-then BUILTLIBS="-lcdd $BUILTLIBS"
-else LIBS="-lcdd $LIBS"
-fi
+LIBS="-lcdd $LIBS"
+CPPFLAGS="$CPPFLAGS -I/usr/include/cdd"
 
 AC_LANG(C)
 AC_CHECK_HEADER(flint/flint.h,LIBS="-lflint -lgmp $LIBS",BUILD_flint=yes)
