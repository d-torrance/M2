Author: Doug Torrance <dtorrance@piedmont.edu>
Last-Update: 2020-11-03

--- a/M2/Macaulay2/tests/normal/core-tests.m2
+++ b/M2/Macaulay2/tests/normal/core-tests.m2
@@ -1876,11 +1876,6 @@
 J = substitute(I,S)
 installHilbertFunction(J, hf)
