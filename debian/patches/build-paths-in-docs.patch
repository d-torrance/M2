+     cmd = cmd | readmode(SetOutputFile,  ">>" | format toAbsolutePath tmpf);
+     cmd = cmd | readmode(SetCaptureErr,  "2>&1");
+     if debugLevel > 0 then stderr << cmd << endl;
+     for fn in examplefiles do copyFile(fn,rundir | baseFilename fn);
