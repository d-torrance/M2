Description: Don't overwrite LDFLAGS from environment
 That way we can still use the LDFLAGS from dpkg-buildflags for hardening.
Author: Doug Torrance <dtorrance@piedmont.edu>
Forwarded: https://github.com/Macaulay2/M2/pull/1388
Applied-Upstream: 1.17, https://github.com/Macaulay2/M2/commit/74cbc04
Last-Update: 2020-09-18

--- a/M2/Macaulay2/c/Makefile.in
+++ b/M2/Macaulay2/c/Makefile.in
@@ -9,7 +9,6 @@
 # In this directory, we compile "scc1", the D to C translator, which we want to run
 # on the "build" machine, in the sense of autoconf.  So we do not want the cross-compiling compiler:
 CC = @CC_FOR_BUILD@
-LDFLAGS = $(LDFLAGS_FOR_BUILD)
 
 top_srcdir = @top_srcdir@
 VPATH = @srcdir@
