#!/usr/bin/make -f

export DEB_CPPFLAGS_MAINT_APPEND=-I/usr/src/gtest
export DEB_BUILD_MAINT_OPTIONS=hardening=+all
UNBUILT_PROGRAMS = 4ti2 gfan normaliz nauty cddplus lrslib topcom cohomcalg \
	csdp
UVER = 1.15

%:
	dh $@ --sourcedirectory=M2

override_dh_auto_configure:
	dh_auto_configure -- --with-unbuilt-programs="$(UNBUILT_PROGRAMS)" \
		--disable-shared --libdir=\$${exec_prefix}/lib \
		--enable-debug
# --disable-shared needed for install-dynamic-libraries target in
# M2/libraries/Makefile.  Otherwise, it tries to cd into $(BUILTLIBPATH)/lib,
# which doesn't exist since we haven't built any libraries.
# Ideally, we should set SHARED to 'no' if BUILTLIBS is empty.  But this
# is currently not possible upstream until the whole "can't compile with
# regular gmp" problem is fixed.  Once it is, prepare a pull request.

get-orig-source:
	rm -f release-${UVER}.tar.gz
	wget https://github.com/Macaulay2/M2/archive/release-${UVER}.tar.gz
	git checkout release-${UVER}
	git pull https://github.com/Macaulay2/M2 release-${UVER}
	echo "`git describe --tags | sed 's/version-//g'`" > version; \
	git checkout debian
	mv -v release-${UVER}.tar.gz ../macaulay2_`cat version`.orig.tar.gz
	rm version

get-orig-source-master:
	rm -f master.tar.gz
	wget https://github.com/Macaulay2/M2/archive/master.tar.gz
	git checkout master
	git pull https://github.com/Macaulay2/M2 master
	echo "`git describe --tags | sed 's/version-//g'`" > version; \
	git checkout debian
	mv -v master.tar.gz ../macaulay2_`cat version`.orig.tar.gz
	rm version

get-orig-source-eigen:
	rm -f eigen.tar.gz
	wget https://github.com/antonleykin/M2/archive/eigen.tar.gz
	git checkout eigen
	git pull https://github.com/antonleykin/M2 eigen
	echo "`git describe --tags | sed 's/version-//g'`" > version; \
	git checkout debian
	mv -v eigen.tar.gz ../macaulay2_`cat version`.orig.tar.gz
	rm version
