#!/usr/bin/make -f

export DEB_CPPFLAGS_MAINT_APPEND=-I/usr/include/singular \
	-I/usr/include/$(DEB_BUILD_MULTIARCH)/singular \
	-DMATHIC_VERSION_STRING=\"$(shell pkg-config mathic --modversion)\" \
	-DMATHICGB_VERSION_STRING=\"$(shell pkg-config mathicgb --modversion)\" \
	-DMEMTAILOR_VERSION_STRING=\"$(shell pkg-config memtailor --modversion)\"

%:
	dh $@ --sourcedirectory=M2 --with autoreconf

override_dh_auto_configure:
	dh_auto_configure -- --with-unbuilt-programs="4ti2 gfan normaliz nauty cddplus lrslib gftables"

get-orig-source:
	uscan --verbose --force-download --rename
