#!/usr/bin/make -f

export DEB_CPPFLAGS_MAINT_APPEND=-I/usr/src/gtest
export DEB_BUILD_MAINT_OPTIONS=hardening=+all
export VERBOSE=1
UNBUILT_PROGRAMS = 4ti2 gfan normaliz nauty cddplus lrslib topcom cohomcalg \
	csdp
UVER = 1.15

%:
	dh $@ --sourcedirectory=M2

override_dh_auto_configure:
	dh_auto_configure -- --with-unbuilt-programs="$(UNBUILT_PROGRAMS)" \
		--disable-shared --libdir=\$${exec_prefix}/lib \
		--enable-debug
# --disable-shared needed for install-dynamic-libraries target in
# M2/libraries/Makefile.  Otherwise, it tries to cd into $(BUILTLIBPATH)/lib,
# which doesn't exist since we haven't built any libraries.
# Ideally, we should set SHARED to 'no' if BUILTLIBS is empty.  But this
# is currently not possible upstream until the whole "can't compile with
# regular gmp" problem is fixed.  Once it is, prepare a pull request.

# replace build paths with installation paths in documentation
override_dh_auto_install:
	find M2/usr-dist/common/share/doc/Macaulay2 \
		\( -name "*.html" -o -name "*.out" \) -exec sed -i \
		-e "s|$CURDIR/M2/Macaulay2/m2|/usr/share/Macaulay2/Core|g" \
		-e "s|$CURDIR/M2/Macaulay2/packages|/usr/share/Macaulay2|g" \
		-e "s|$CURDIR/M2/usr-dist|/usr|g" \
		-e "s|common/share|share|g" \
		-e "s|/nonexistent|/home/username|g" {} +
# package-contains-vcs-control-file
	rm -f M2/usr-dist/common/share/Macaulay2/Macaulay2Doc/test/.gitignore
	dh_auto_install

# https://github.com/Macaulay2/M2/issues/1144
override_dh_link:
	jdupes -rl debian/macaulay2-common/usr/share/doc/Macaulay2
	dh_link

iso:
	genisoimage -R -o m2.iso ~/pbuilder/sid_result/mac*$(REF)*.deb
