To test potential pull requests:

schroot -c trusty-amd64 -u root
apt-get update
apt-get install git autoconf pkg-config wget libncurses-dev fortran-compiler libxml2-dev libz-dev liblzma-dev libtool unzip bison time install-info flex
git clone -b <branch> https://github.com/d-torrance/M2
cd M2/M2
make
./configure --enable-download
make
