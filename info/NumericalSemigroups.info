|    elapsedTime nonWeierstrassSemigroups(8,11, LLdifficult, Verbose => true) |
|    LLdifficult={}                                                           |
|    elapsedTime nonWeierstrassSemigroups(9,11, LLdifficult, Verbose => true) |
