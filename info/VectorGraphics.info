|                                          |  1 |                             |
|             RadiusX => 40                                                   |
|             RadiusY => 30                                                   |
|             style => MutableHashTable{...1...}                              |
|                                                                             |
|o1 : Ellipse                                                                 |
|-----------------------------------------------------------------------------|
|100%","stop-color:yellow")}}                                                 |
