+-----------------------------------+
|i5 : x_"foo" = 6                   |
|                                   |
|o5 = 6                             |
|                                   |
|o5 : ForeignObject of type int32   |
+-----------------------------------+
|i6 : x                             |
|                                   |
|o6 = HashTable{"bar" => 3.14159}   |
|               "foo" => 6          |
|                                   |
|o6 : ForeignObject of type mystruct|
+-----------------------------------+

