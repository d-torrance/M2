|i2 : K = koszulComplex vars Q                                        |
|                                                                     |
|      1      3      3      1                                         |
|o2 = Q  <-- Q  <-- Q  <-- Q                                          |
|                                                                     |
|     0      1      2      3                                          |
|                                                                     |
|o2 : Complex                                                         |
+---------------------------------------------------------------------+
|i3 : phi = elapsedTime exteriorInclusion(K,3); --specify top degree 3|
| -- .249823s elapsed                                                 |
