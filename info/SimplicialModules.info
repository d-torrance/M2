|i2 : K = koszulComplex vars Q                                            |
|                                                                         |
|      1      4      6      4      1                                      |
|o2 = Q  <-- Q  <-- Q  <-- Q  <-- Q                                       |
|                                                                         |
|     0      1      2      3      4                                       |
|                                                                         |
|o2 : Complex                                                             |
+-------------------------------------------------------------------------+
|i3 : S = simplicialModule(K, 6, Degeneracy => true)                      |
|                                                                         |
|      1      5      15      35      70      126      210                 |
|o3 = Q  <-- Q  <-- Q   <-- Q   <-- Q   <-- Q    <-- Q   <-- ...          |
|                                                                         |
|     0      1      2       3       4       5        6                    |
|                                                                         |
|o3 : SimplicialModule                                                    |
+-------------------------------------------------------------------------+
|i4 : elapsedTime S**S                                                    |
| -- .486226s elapsed                                                     |
|                                                                         |
|      1      25      225      1225      4900      15876      44100       |
|o4 = Q  <-- Q   <-- Q    <-- Q     <-- Q     <-- Q      <-- Q     <-- ...|
|                                                                         |
|     0      1       2        3         4         5          6            |
|                                                                         |
|o4 : SimplicialModule                                                    |
