|      1      2      3      4                                               |
|o3 = S  <-- S  <-- S  <-- S <-- ...                                        |
|                                                                           |
|     0      1      2      3                                                |
|                                                                           |
|o3 : SimplicialModule                                                      |
+---------------------------------------------------------------------------+
|i4 : Cc = simplicialModule(complex {matrix{{c}}}, 3)                       |
|                                                                           |
|      1      2      3      4                                               |
|o4 = S  <-- S  <-- S  <-- S <-- ...                                        |
|                                                                           |
|     0      1      2      3                                                |
|                                                                           |
|o4 : SimplicialModule                                                      |
