+------------------------------------------------------------------+
|i4 : g = extend( resolution (R^1/I), resolution (R^1/J), id_(R^1))|
|                                                                  |
|          1             1                                         |
|o4 = 0 : R  <--------- R  : 0                                     |
|               | 1 |                                              |
|                                                                  |
|          3                           6                           |
|     1 : R  <----------------------- R  : 1                       |
|               {1} | a b 0 0 0 0 |                                |
|               {1} | 0 0 b 0 0 0 |                                |
|               {1} | 0 0 0 a b c |                                |
|                                                                  |
|          3                               8                       |
|     2 : R  <--------------------------- R  : 2                   |
|               {2} | 0 b 0 0 0 0 0 0 |                            |
|               {2} | 0 0 a b 0 0 0 0 |                            |
|               {2} | 0 0 0 0 0 b 0 0 |                            |
|                                                                  |
|          1                     3                                 |
|     3 : R  <----------------- R  : 3                             |
|               {3} | 0 b 0 |                                      |
|                                                                  |
|     4 : 0 <----- 0 : 4                                           |
|              0                                                   |
|                                                                  |
|o4 : ChainComplexMap                                              |
+------------------------------------------------------------------+
|i5 : g_1                                                          |
|                                                                  |
|o5 = {1} | a b 0 0 0 0 |                                          |
|     {1} | 0 0 b 0 0 0 |                                          |
|     {1} | 0 0 0 a b c |                                          |
|                                                                  |
|             3      6                                             |
|o5 : Matrix R  <-- R                                              |
+------------------------------------------------------------------+
|i6 : g_2                                                          |
|                                                                  |
|o6 = {2} | 0 b 0 0 0 0 0 0 |                                      |
|     {2} | 0 0 a b 0 0 0 0 |                                      |
|     {2} | 0 0 0 0 0 b 0 0 |                                      |
|                                                                  |
|             3      8                                             |
|o6 : Matrix R  <-- R                                              |
