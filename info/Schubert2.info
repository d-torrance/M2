|i1 : G = flagBundle({2,2})                                                   |
|                                                                             |
|o1 = G                                                                       |
|                                                                             |
|o1 : a flag bundle with subquotient ranks {2:2}                              |
+-----------------------------------------------------------------------------+
|i2 : (S,T,U) = schubertRing G                                                |
|                                                                             |
|                                               QQ[][H   ..H   ]              |
|                                                     1,1   2,2               |
|o2 = (S, T, map (------------------------------------------------------------|
|                 (- H    - H   , - H    - H   H    - H   , - H   H    - H   H|
|                     1,1    2,1     1,2    1,1 2,1    2,2     1,2 2,1    1,1 |
|     ------------------------------------------------------------------------|
|                                    2                            2           |
|     ---------------, S, {1, H   , H    - H   , H   , H   H   , H   }))      |
|        , -H   H   )          2,1   2,1    2,2   2,2   2,1 2,2   2,2         |
|     2,2    1,2 2,2                                                          |
|                                                                             |
|o2 : Sequence                                                                |
+-----------------------------------------------------------------------------+
|i3 : c = schubertCycle({1,0},G)                                              |
|                                                                             |
|o3 = H                                                                       |
|      2,1                                                                    |
|                                                                             |
|                                   QQ[][H   ..H   ]                          |
|                                         1,1   2,2                           |
|o3 : ------------------------------------------------------------------------|
|     (- H    - H   , - H    - H   H    - H   , - H   H    - H   H   , -H   H |
|         1,1    2,1     1,2    1,1 2,1    2,2     1,2 2,1    1,1 2,2    1,2 2|
|-----------------------------------------------------------------------------|
|---                                                                          |
|  )                                                                          |
|,2                                                                           |
+-----------------------------------------------------------------------------+
|i4 : a = T c                                                                 |
|                                                                             |
|o4 = s                                                                       |
|      {1, 0}                                                                 |
|                                                                             |
|o4 : Schubert Basis of G(2,4) over point                                     |
+-----------------------------------------------------------------------------+
|i5 : a^2                                                                     |
|                                                                             |
|o5 = s       + s                                                             |
|      {1, 1}    {2, 0}                                                       |
|                                                                             |
|o5 : Schubert Basis of G(2,4) over point                                     |
+-----------------------------------------------------------------------------+
|i6 : U oo                                                                    |
|                                                                             |
|      2                                                                      |
|o6 = H                                                                       |
|      2,1                                                                    |
|                                                                             |
|                                   QQ[][H   ..H   ]                          |
|                                         1,1   2,2                           |
|o6 : ------------------------------------------------------------------------|
|     (- H    - H   , - H    - H   H    - H   , - H   H    - H   H   , -H   H |
|         1,1    2,1     1,2    1,1 2,1    2,2     1,2 2,1    1,1 2,2    1,2 2|
|-----------------------------------------------------------------------------|
|---                                                                          |
|  )                                                                          |
|,2                                                                           |
