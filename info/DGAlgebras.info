  * *note masseyTripleProduct(DGAlgebra,ZZ,ZZ,ZZ):
    masseyTripleProduct_lpDGAlgebra_cmZZ_cmZZ_cmZZ_rp, -- Computes the matrix
    representing all triple Massey operations.

