|i3 : R = Q/I                                                                 |
|                                                                             |
|o3 = R                                                                       |
|                                                                             |
|o3 : QuotientRing                                                            |
+-----------------------------------------------------------------------------+
|i4 : KR = koszulComplexDGA R                                                 |
|                                                                             |
|o4 = {Ring => R                          }                                   |
|      Underlying algebra => R[T   ..T   ]                                    |
|                               1,1   1,3                                     |
|      Differential => {x, y, z}                                              |
|                                                                             |
|o4 : DGAlgebra                                                               |
+-----------------------------------------------------------------------------+
|i5 : z1 = x^2*T_(1,1)                                                        |
|                                                                             |
|      2                                                                      |
|o5 = x T                                                                     |
|        1,1                                                                  |
|                                                                             |
|o5 : R[T   ..T   ]                                                           |
|        1,1   1,3                                                            |
+-----------------------------------------------------------------------------+
|i6 : z2 = y^2*T_(1,2)                                                        |
|                                                                             |
|      2                                                                      |
