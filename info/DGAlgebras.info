|i3 : isWellDefinedDifferential A          |
|                                          |
|o3 = true                                 |
+------------------------------------------+
|i4 : M = freeDGModule(A, {0})             |
|                                          |
|o4 = {Base ring => R                    } |
|      DG algebra => R[T   ..T   ]         |
|                       1,1   1,2          |
|                                       1  |
|      Natural module => (R[T   ..T   ])   |
|                            1,1   1,2     |
|      Generator degrees => {{0, 0}}       |
|      Differentials on gens => {0}        |
|                                          |
|o4 : DGModule                             |
