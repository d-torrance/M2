|      Natural module => Anat                       |
|      Generator degrees => {{0, 0}}                |
|      Differentials on gens => {0}                 |
|                                                   |
|o6 : DGModule                                      |
+---------------------------------------------------+
|i7 : S = dgSubmodule(M1, matrix {{x_Anat, y_Anat}})|
|                                                   |
|o7 = DGSubmodule of ambient DGModule               |
|     Degrees  => {{0, 1}, {0, 1}}                  |
|                     2                             |
|     natural  => Anat                              |
|     inclusion => | x y |                          |
|                                                   |
|o7 : DGSubmodule                                   |
+---------------------------------------------------+
|i8 : isHomogeneous S                               |
|                                                   |
|o8 = true                                          |
+---------------------------------------------------+
|i9 : Q = M1 / S                                    |
|                                                   |
|o9 = DGQuotientModule Q = M / S                    |
|     Q.natural = cokernel | x y |                  |
|     Degrees   = {{0, 0}}                          |
|                                                   |
|o9 : DGQuotientModule                              |
+---------------------------------------------------+
|i10 : isHomogeneous Q                              |
|                                                   |
|o10 = true                                         |
+---------------------------------------------------+

