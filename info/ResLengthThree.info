|                                                                |
|o5 = 0                                                          |
|                                                                |
|o5 : A                                                          |
+----------------------------------------------------------------+
|i6 : e_1*f_3                                                    |
|                                                                |
|o6 = g                                                          |
|      1                                                         |
|                                                                |
|o6 : A                                                          |
+----------------------------------------------------------------+
|i7 : f_1*f_2                                                    |
|                                                                |
|o7 = 0                                                          |
|                                                                |
|o7 : A                                                          |
+----------------------------------------------------------------+

