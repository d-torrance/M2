  * *note binomialMinimalPrimes: binomialMinimalPrimes, -- minimal primes of a
    binomial Ideal
  * *note cellularBinomialAssociatedPrimes: cellularBinomialAssociatedPrimes,
    -- Associated primes of a cellular binomial ideal

