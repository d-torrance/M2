+--------------------------------+
|i2 : d = {3,3}                  |
|                                |
|o2 = {3, 3}                     |
|                                |
|o2 : List                       |
+--------------------------------+
|i3 : W = matrix{{1,0,1},{0,1,1}}|
|                                |
|o3 = | 1 0 1 |                  |
|     | 0 1 1 |                  |
|                                |
|              2       3         |
|o3 : Matrix ZZ  <-- ZZ          |
+--------------------------------+
|i4 : A = diagonalAction(W, d, R)|
|                                |
|o4 = R <- ZZ/3 x ZZ/3 via       |
|                                |
|     | 1 0 1 |                  |
|     | 0 1 1 |                  |
|                                |
|o4 : DiagonalAction             |
+--------------------------------+
|i5 : cyclicFactors A            |
|                                |
|o5 = {3, 3}                     |
|                                |
|o5 : List                       |
