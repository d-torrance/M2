|      {2} | -x_2 -x_1 x_4  0    0    0    x_4  x_3  |  {2} | -t_2 t_1 0      |
|      {2} | x_1  x_0  -x_3 0    0    x_4  0    0    |  {2} | 0    0   0      |
|      {2} | 0    0    -x_3 -x_2 -x_1 0    -x_3 -x_2 |  {2} | 0    0   -t_4   |
|      {2} | 0    0    x_2  x_1  x_0  -x_3 0    0    |  {2} | 0    0   0      |
|      {2} | 0    0    0    0    0    x_2  x_1  x_0  |  {2} | 0    0   t_1    |
|     ------------------------------------------------------------------------|
|     0    0    0       0    0    |})                                         |
|     0    -t_3 0       0    0    |                                           |
|     -t_3 0    0       0    -t_3 |                                           |
