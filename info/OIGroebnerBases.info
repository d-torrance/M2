|        2,3 2,2 1,1 3,{2, 3},3    2,1 1,2 3,{1, 3},3   1,2 1,1 2,{2},2       |
|      -----------------------------------------------------------------------|
|      x   x   e          , x   e        + x   e       }                      |
|       2,2 2,1 2,{1, 2},3   1,1 1,{1},1    2,1 1,{1},2                       |
