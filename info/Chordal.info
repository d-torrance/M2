|                   9      9      9   9               |
|                  x  => {x , x ,  }                  |
|                   4      4   4                      |
|                  x  => {x , x ,  }                  |
|                   8      8   8                      |
|                  x   => {x  ,  , x  , x  }          |
|                   10      10      10   10           |
