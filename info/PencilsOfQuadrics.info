|i1 : kk=ZZ/101                                                          |
|                                                                        |
|o1 = kk                                                                 |
|                                                                        |
|o1 : QuotientRing                                                       |
+------------------------------------------------------------------------+
|i2 : setRandomSeed 0                                                    |
| -- setting random seed to 0                                            |
|                                                                        |
|o2 = 0                                                                  |
+------------------------------------------------------------------------+
|i3 : g=1                                                                |
|                                                                        |
|o3 = 1                                                                  |
+------------------------------------------------------------------------+
|i4 : (S, qq,  R,  u, M1, M2, Mu1, Mu2)=randomNicePencil(kk,g) ;         |
+------------------------------------------------------------------------+
|i5 : (uOdd,uEv)=cliffordOperators(Mu1,Mu2,R);                           |
+------------------------------------------------------------------------+
|i6 : symMatrix(uOdd,uEv)                                                |
|                                                                        |
|o6 = | -5t  -50s 6t     -6t  |                                          |
|     | -50s 0    -9t    5t   |                                          |
|     | 6t   -9t  -s-30t 3t   |                                          |
|     | -6t  5t   3t     -48t |                                          |
|                                                                        |
|             4      4                                                   |
|o6 : Matrix R  <-- R                                                    |
