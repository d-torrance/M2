|             2 => {3}                                                |
|             3 => {4}                                                |
|             4 => {2}                                                |
|                                                                     |
|o1 : Digraph                                                         |
+---------------------------------------------------------------------+
|i2 : isCyclic D                                                      |
|                                                                     |
|o2 = true                                                            |
+---------------------------------------------------------------------+

