|i1 : G = graph({1,2,3,4},{{2,3},{3,4}});|
+----------------------------------------+
|i2 : neighbors(G,3)                     |
|                                        |
|o2 = set {4, 2}                         |
|                                        |
|o2 : Set                                |
+----------------------------------------+

