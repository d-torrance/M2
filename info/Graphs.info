|o1 = Graph{0 => {1, 2, 3}}      |
|           1 => {0, 2, 3}       |
|           2 => {0, 1, 3}       |
|           3 => {0, 1, 2}       |
|                                |
|o1 : Graph                      |
+--------------------------------+
|i2 : H = addVertices(G, {3,4,5})|
|                                |
|o2 = Graph{0 => {1, 2, 3}}      |
|           1 => {0, 2, 3}       |
|           2 => {0, 1, 3}       |
|           3 => {0, 1, 2}       |
|           4 => {}              |
|           5 => {}              |
|                                |
|o2 : Graph                      |
+--------------------------------+

