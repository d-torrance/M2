|           7 => {0, 8, 9}                                           |
|           8 => {0, 7, 9}                                           |
|           9 => {0, 7, 8}                                           |
|           10 => {0, 11, 12}                                        |
|           11 => {0, 10, 12}                                        |
|           12 => {0, 10, 11}                                        |
|           13 => {0, 14, 15}                                        |
|           14 => {0, 13, 15}                                        |
|           15 => {0, 13, 14}                                        |
|                                                                    |
|o1 : Graph                                                          |
+--------------------------------------------------------------------+

