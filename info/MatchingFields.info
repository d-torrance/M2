|                                                                             |
|o1 = | 0  0  0  0  0 0 |                                                     |
|     | 1  3  2  4  6 5 |                                                     |
|     | 35 28 21 14 7 0 |                                                     |
|                                                                             |
|              3       6                                                      |
|o1 : Matrix ZZ  <-- ZZ                                                       |
|-----------------------------------------------------------------------------|
|UsePrimePowers => true, ScalingCoefficient => 1)                             |
+-----------------------------------------------------------------------------+
|i2 : getWeightMatrix matchingFieldFromPermutation(3, 6, {1, 3, 2, 4, 6, 5},  |
|                                                                             |
|o2 = | 0  0  0  0  0  0  |                                                   |
|     | 2  6  4  8  12 10 |                                                   |
|     | 35 28 21 14 7  0  |                                                   |
|                                                                             |
|              3       6                                                      |
|o2 : Matrix ZZ  <-- ZZ                                                       |
|-----------------------------------------------------------------------------|
|UsePrimePowers => true, ScalingCoefficient => 2)                             |
+-----------------------------------------------------------------------------+
|i3 : getWeightMatrix matchingFieldFromPermutation(3, 6, {1, 3, 2, 4, 6, 5},  |
|                                                                             |
|o3 = | 0  0  0  0  0  0  |                                                   |
|     | 3  9  6  12 18 15 |                                                   |
|     | 35 28 21 14 7  0  |                                                   |
|                                                                             |
|              3       6                                                      |
|o3 : Matrix ZZ  <-- ZZ                                                       |
|-----------------------------------------------------------------------------|
|UsePrimePowers => true, ScalingCoefficient => 3)                             |
