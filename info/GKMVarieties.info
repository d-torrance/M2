|i1 : X = generalizedFlagVariety("A",3,{2}); -- The Grassmannian Gr(2,4)      |
+-----------------------------------------------------------------------------+
|i2 : f = diagonalMap X;                                                      |
+-----------------------------------------------------------------------------+
|i3 : peek f                                                                  |
|                                                                             |
|o3 = EquivariantMap{cache => CacheTable{}                                    |
|                    ptsMap => HashTable{{set {0, 1}} => ({set {0,            |
|                                        {set {0, 2}} => ({set {0,            |
|                                        {set {0, 3}} => ({set {0,            |
|                                        {set {1, 2}} => ({set {1,            |
|                                        {set {1, 3}} => ({set {1,            |
|                                        {set {2, 3}} => ({set {2,            |
|                    source => a "GKM variety" with an action of a            |
|                    target => a "GKM variety" with an action of a            |
|-----------------------------------------------------------------------------|
|                   }                                                         |
|1}}, {set {0, 1}})}                                                          |
|2}}, {set {0, 2}})                                                           |
|3}}, {set {0, 3}})                                                           |
|2}}, {set {1, 2}})                                                           |
|3}}, {set {1, 3}})                                                           |
|3}}, {set {2, 3}})                                                           |
|4-dimensional torus                                                          |
|4-dimensional torus                                                          |
