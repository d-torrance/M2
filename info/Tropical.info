|i3 : isPrime I                        |
|                                      |
|o3 = false                            |
+--------------------------------------+
|i4 : T=tropicalVariety(I,Prime=>false)|
|                                      |
|o4 = T                                |
|                                      |
|o4 : TropicalCycle                    |
+--------------------------------------+

