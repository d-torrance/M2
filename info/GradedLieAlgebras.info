|o2 = E                              |
|                                    |
|o2 : ExtAlgebra                     |
+------------------------------------+
|i3 : basis(2,E)                     |
|                                    |
|o3 = {ext_3, ext_4}                 |
|                                    |
|o3 : List                           |
+------------------------------------+
|i4 : ext_4+2 ext_3                  |
|                                    |
|o4 = 2ext_3 + ext_4                 |
|                                    |
|o4 : E                              |
+------------------------------------+

