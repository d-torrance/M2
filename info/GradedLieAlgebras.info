|                                                |
|o23 = generators => {a, b, c}                   |
|      Weights => {{1, 0}, {1, 0}, {2, 0}}       |
|      Signs => {1, 0, 0}                        |
|      ideal => { - c + (a a),  - (1/2)(b a a)}  |
|      ambient => F                              |
|      diff => {}                                |
|      Field => QQ                               |
|      computedDegree => 4                       |
