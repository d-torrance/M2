|     ideal => {(a1 a0) - (a2 a1) - (a3 a1), (a2 a0) + (a2 a1) - (a3 a2), (a3 |
|     ambient => LieAlgebra{...10...}                                         |
|     diff => {}                                                              |
|     Field => QQ                                                             |
|     computedDegree => 0                                                     |
|-----------------------------------------------------------------------------|
|a0) + (a3 a1) + (a3 a2), (a4 a0) - (a5 a4), (a5 a0) + (a5 a4), (a4 a1) - (a6 |
|-----------------------------------------------------------------------------|
|a4), (a6 a1) + (a6 a4), (a4 a2), (a4 a3), (a5 a1), (a5 a2), (a5 a3), (a6 a0),|
