|o2 = L                                          |
|                                                |
|o2 : LieAlgebra                                 |
+------------------------------------------------+
|i3 : E = extAlgebra(3,L)                        |
|                                                |
|o3 = E                                          |
|                                                |
|o3 : ExtAlgebra                                 |
+------------------------------------------------+
|i4 : (3*x+1) (ext_1 ext_2)+(2*x+3) (ext_2 ext_1)|
|                                                |
|o4 = (-x+2)ext_3                                |
|                                                |
|o4 : E                                          |
+------------------------------------------------+

