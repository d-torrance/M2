|                                                                             |
|o2 = Matroid{bases => {set {0, 1, 2}, set {0, 1, 3}, set {0, 2, 3}, set {1,  |
|             cache => CacheTable{...1...}                                    |
|             groundSet => set {0, 1, 2, 3, 4}                                |
|             rank => 3                                                       |
|-----------------------------------------------------------------------------|
|2, 3}, set {4, 0, 1}, set {4, 0, 2}, set {4, 1, 2}, set {4, 0, 3}, set {4, 1,|
|-----------------------------------------------------------------------------|
|3}, set {4, 2, 3}}}                                                          |
