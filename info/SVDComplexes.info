|i1 : needsPackage "RandomComplexes"                                          |
|                                                                             |
|o1 = RandomComplexes                                                         |
|                                                                             |
|o1 : Package                                                                 |
+-----------------------------------------------------------------------------+
|i2 : h = {1,4,6,5,1}                                                         |
|                                                                             |
|o2 = {1, 4, 6, 5, 1}                                                         |
|                                                                             |
|o2 : List                                                                    |
