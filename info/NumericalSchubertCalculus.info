|i1 : R := ZZ; n := 6; m := matrix{{3, 2, 4, 6}};                             |
|                                                                             |
|              1       4                                                      |
|o3 : Matrix ZZ  <-- ZZ                                                       |
+-----------------------------------------------------------------------------+
|i4 : result := LRtriple(n,m);                                                |
