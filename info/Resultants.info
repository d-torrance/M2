|     3x   x   , 3x   x    + 2x   x    + x   x   , x   x    - x   x    -      |
|       0,2 1,3    0,1 1,0     0,2 1,1    0,3 1,2   0,0 1,0    0,2 1,2        |
|     ------------------------------------------------------------------------|
|                 2                                     2                     |
|     2x   x   , x    - x   x   , x   x    - x   x   , x    - x   x   ,       |
|       0,3 1,3   0,2    0,1 0,3   0,1 0,2    0,0 0,3   0,1    0,0 0,2        |
