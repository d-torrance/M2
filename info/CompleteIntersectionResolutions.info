|i2 : S = ZZ/101[a,b,c];                                                      |
+-----------------------------------------------------------------------------+
|i3 : ff = matrix"a3,b3";                                                     |
|                                                                             |
|             1      2                                                        |
|o3 : Matrix S  <-- S                                                         |
+-----------------------------------------------------------------------------+
|i4 : R = S/ideal ff;                                                         |
+-----------------------------------------------------------------------------+
|i5 : M = highSyzygy (R^1/ideal vars R);                                      |
+-----------------------------------------------------------------------------+
|i6 : mf = matrixFactorization (ff, M)                                        |
|                                                                             |
|o6 = {{4} | -c b 0  a2 0  0  0  0  0   |, {5} | 0 a2 0  -b 0  0   0   0 0  0 |
