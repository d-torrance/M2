|                                                                             |
|o5 = map (R, R, {p        - p       , p        - p       , p        -        |
|                  1,1,1,1    2,1,1,1   1,1,1,2    2,1,1,2   1,1,2,1          |
|                                                                             |
|o5 : RingMap R <-- R                                                         |
|-----------------------------------------------------------------------------|
|p       , p        - p       , p        - p       , p        - p       ,     |
| 2,1,2,1   1,1,2,2    2,1,2,2   1,2,1,1    2,2,1,1   1,2,1,2    2,2,1,2      |
|-----------------------------------------------------------------------------|
|p        - p       , p        - p       , p       , p       , p       ,      |
| 1,2,2,1    2,2,2,1   1,2,2,2    2,2,2,2   2,1,1,1   2,1,1,2   2,1,2,1       |
|-----------------------------------------------------------------------------|
|p       , p       , p       , p       , p       })                           |
| 2,1,2,2   2,2,1,1   2,2,1,2   2,2,2,1   2,2,2,2                             |
