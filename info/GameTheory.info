+----------------------------------------------------------------------------+
|i3 : A#{0,0} = 3;  A#{0,1} = 0;  A#{1,0} = 0;  A#{1,1} = 2;                 |
+----------------------------------------------------------------------------+
|i7 : B#{0,0} = 2;  B#{0,1} = 0;  B#{1,0} = 0;  B#{1,1} = 3;                 |
