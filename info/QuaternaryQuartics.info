|                                                                             |
|o14 = true                                                                   |
+-----------------------------------------------------------------------------+
|i15 : target f == R^1                                                        |
|                                                                             |
|o15 = true                                                                   |
+-----------------------------------------------------------------------------+
|i16 : degree f == {3}                                                        |
|                                                                             |
|o16 = true                                                                   |
+-----------------------------------------------------------------------------+
|i17 : ker f == 0                                                             |
|                                                                             |
|o17 = true                                                                   |
+-----------------------------------------------------------------------------+
|i18 : J = ideal image f                                                      |
|                                                                             |
|                                                            2       3      2 |
|o18 = ideal (0, - 39a*d - 16b*d + 38c*d, 39a*c + 16b*c - 38c , - 16c  - 39b d|
|      -----------------------------------------------------------------------|
|             2     2                                                         |
|      + 38a*d , 39a d + 16a*b*d - 38a*c*d, 0)                                |
