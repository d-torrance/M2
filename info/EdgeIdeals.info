|i4 : independenceNumber c4                                              |
|                                                                        |
|o4 = 3                                                                  |
+------------------------------------------------------------------------+
|i5 : independenceNumber c5                                              |
|                                                                        |
|o5 = 2                                                                  |
+------------------------------------------------------------------------+
|i6 : dim independenceComplex c4 + 1 == independenceNumber c4            |
|                                                                        |
|o6 = true                                                               |
