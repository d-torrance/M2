|i8 : f = yonedaMap' g                                                        |
|                                                                             |
|o8 = {-4} | 24bc3+19c4-36bc2d+19c3d-30bcd2-10c2d2-29bd3-29cd3-8d4 |          |
|     {-2} | -22d2                                                 |          |
|     {-2} | 0                                                     |          |
|     {-2} | -29d2                                                 |          |
|     {-2} | -24c2-38cd-16d2                                       |          |
|     {-2} | 0                                                     |          |
