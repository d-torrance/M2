+-----------------------------------------------+
|i4 : D = C1 ++ C2                              |
|                                               |
|                            3      3      1    |
|o4 = image | 1 0 0 0 | <-- S  <-- S  <-- S     |
|           | 0 a b c |                         |
|                           1      2      3     |
|     0                                         |
|                                               |
|o4 : Complex                                   |
+-----------------------------------------------+
|i5 : L = components D                          |
|                                               |
|       1      3      3      1                  |
|o5 = {S  <-- S  <-- S  <-- S , image | a b c |}|
|                                               |
|      0      1      2      3   0               |
|                                               |
|o5 : List                                      |
+-----------------------------------------------+
|i6 : L_0 === C1                                |
|                                               |
|o6 = true                                      |
+-----------------------------------------------+
|i7 : L_1 === C2                                |
|                                               |
|o7 = true                                      |
