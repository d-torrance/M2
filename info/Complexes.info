|                                                                 |
|     0      1      2      3                                      |
|                                                                 |
|o2 : Complex                                                     |
+-----------------------------------------------------------------+
|i3 : C2 = complex (ideal(a,b,c))                                 |
|                                                                 |
|o3 = image | a b c |                                             |
|                                                                 |
|     0                                                           |
|                                                                 |
|o3 : Complex                                                     |
+-----------------------------------------------------------------+
|i4 : D = C1 ++ C2                                                |
|                                                                 |
|                            3      3      1                      |
|o4 = image | 1 0 0 0 | <-- S  <-- S  <-- S                       |
|           | 0 a b c |                                           |
|                           1      2      3                       |
|     0                                                           |
|                                                                 |
|o4 : Complex                                                     |
+-----------------------------------------------------------------+
|i5 : D_[0]                                                       |
|                                                                 |
|                                           1                     |
|o5 = 0 : image | 1 0 0 0 | <------------- S  : 0                 |
|               | 0 a b c |    {0} | 1 |                          |
|                              {1} | 0 |                          |
|                              {1} | 0 |                          |
|                              {1} | 0 |                          |
|                                                                 |
