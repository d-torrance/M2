+---------------------------------------------------------+
|i15 : h_[0]^[1] == 0                                     |
|                                                         |
|o15 = true                                               |
+---------------------------------------------------------+
|i16 : h_[1]^[0] == 0                                     |
|                                                         |
|o16 = true                                               |
+---------------------------------------------------------+
|i17 : assert(h == map(D1 ++ D2, C1 ++ C2, {{f,0},{0,g}}))|
