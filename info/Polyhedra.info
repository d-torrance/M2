|                             |
|o2 = | 2 |                   |
|     | 4 |                   |
|     | 8 |                   |
|                             |
|              3       1      |
|o2 : Matrix ZZ  <-- ZZ       |
+-----------------------------+
|i3 : q = matrix{{2},{6},{20}}|
|                             |
|o3 = | 2  |                  |
|     | 6  |                  |
|     | 20 |                  |
|                             |
|              3       1      |
|o3 : Matrix ZZ  <-- ZZ       |
+-----------------------------+
|i4 : inInterior(p,P)         |
|                             |
|o4 = false                   |
+-----------------------------+
|i5 : inInterior(q,P)         |
|                             |
|o5 = true                    |
