|                                                                |
|o4 = | -3 -1 1 2 |                                              |
|     | 1  1  1 1 |                                              |
|                                                                |
|              2       4                                         |
|o4 : Matrix ZZ  <-- ZZ                                          |
+----------------------------------------------------------------+

