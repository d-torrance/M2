|              1 3    3 1   1 2    2 1     1 4    4 1     3 2    2 3     2 4  |
|                                                                             |
|                                                                             |
|                                                                             |
|                                                                             |
|     ------------------------------------------------------------------------|
|     x y ), Graph{"edges" => {{x , x }, {x , x }, {x , x }, {x , x }, {x ,   |
|      4 2                       1   3     2   4     1   2     1   4     2    |
|                  "ring" => QQ[x ..x ]                                       |
|                                1   4                                        |
|                  "vertices" => {x , x , x , x }                             |
|                                  1   2   3   4                              |
|     ------------------------------------------------------------------------|
|     x }}})                                                                  |
|      3                                                                      |
|                                                                             |
|o2 : Sequence                                                                |
