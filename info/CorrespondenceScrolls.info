  * "hankelMatrix(Ring,RingElement,ZZ,ZZ)"
  * "hankelMatrix(Ring,ZZ,ZZ)"
  * "hankelMatrix(ZZ,ZZ)"
  * "hankelMatrix(ZZ,ZZ,String)"

