|       2        3   2    2                    2            2   2             |
|      d , d*e, a , a b, a c, a*b*d, a*b*e, a*c , a*d*e, a*e , b d, b*c*d,    |
|      -----------------------------------------------------------------------|
|                2     2   3   2      2     2   3                     2       |
|      b*c*e, b*d , b*e , c , c d, c*d , d*e , e }, {a, d, a*b, a*c, b , b*c, |
