|i4 : C = tailMF m                                                            |
|                                                                             |
|      4      4      4                                                        |
|o4 = S  <-- S  <-- S                                                         |
|                                                                             |
|     0      1      0                                                         |
|                                                                             |
|o4 : ZZdFactorization                                                        |
