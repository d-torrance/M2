|o1 = MixedGraph{Bigraph => Bigraph{d => {e}}}                                |
|                                   e => {d}                                  |
|                Digraph => Digraph{a => {d}}                                 |
|                                   c => {e}                                  |
|                                   d => {}                                   |
|                                   e => {}                                   |
|                                   f => {g}                                  |
|                                   g => {}                                   |
|                Graph => Graph{a => {b}   }                                  |
|                               b => {a, c}                                   |
|                               c => {b}                                      |
|                                                                             |
|o1 : MixedGraph                                                              |
|-----------------------------------------------------------------------------|
|{{d,e}})                                                                     |
