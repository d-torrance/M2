|                                   3 => {4}                                  |
|                                   4 => {3, 2}                               |
|                Digraph => Digraph{1 => {2}}                                 |
|                                   2 => {3}                                  |
|                                   3 => {}                                   |
|                Graph => Graph{1 => {3}}                                     |
|                               3 => {1}                                      |
|                                                                             |
|o1 : MixedGraph                                                              |
+-----------------------------------------------------------------------------+
|i2 : parents (G,1)                                                           |
|                                                                             |
|o2 = set {}                                                                  |
|                                                                             |
|o2 : Set                                                                     |
+-----------------------------------------------------------------------------+
|i3 : parents (G,2)                                                           |
|                                                                             |
|o3 = set {1}                                                                 |
|                                                                             |
|o3 : Set                                                                     |
