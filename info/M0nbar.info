+-----------------------------------------------------------------------------+
|i3 : writeCurveInSingletonSpineBasis(C)                                      |
|                                                                             |
|o3 = CurveClassRepresentativeM0nbar{"CurveExpression" => HashTable{{{1, 2}, {|
|                                                                   {{1, 3, 4,|
|                                                                   {{1, 3, 4,|
|                                                                   {{1, 3, 4,|
|                                                                   {{1, 8}, {|
|                                                                   {{1}, {2, |
|                                                                   {{1}, {2, |
|                                                                   {{1}, {2},|
|                                                                   {{1}, {2},|
|                                                                   {{1}, {2},|
|                                                                   {{1}, {2},|
|                                    "NumberOfMarkedPoints" => 8              |
|                                                                             |
|o3 : CurveClassRepresentativeM0nbar                                          |
|-----------------------------------------------------------------------------|
|3, 4}, {5}, {6, 7, 8}} => 1 }}                                               |
| 5, 6}, {2}, {7}, {8}} => -1                                                 |
| 5, 8}, {2}, {6}, {7}} => 1                                                  |
| 7, 8}, {2}, {5}, {6}} => -1                                                 |
|2}, {3, 4, 5}, {6, 7}} => 1                                                  |
|3, 4, 5}, {6}, {7, 8}} => 1                                                  |
|3, 4, 7, 8}, {5}, {6}} => -1                                                 |
| {3, 4, 5, 6, 7}, {8}} => 1                                                  |
| {3, 4, 5, 6}, {7, 8}} => -1                                                 |
| {3, 4, 6, 7, 8}, {5}} => 1                                                  |
| {3, 4, 7, 8}, {5, 6}} => -1                                                 |
+-----------------------------------------------------------------------------+

