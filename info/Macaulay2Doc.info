|o24 : MethodFunction                               |
+---------------------------------------------------+
|i25 : Grassmannian2(ZZ,ZZ,Ring) := (k,r,R) ->(     |
|              KK := coefficientRing R;             |
|              RPr := KK[Variables => r+1];         |
|              Pr := ideal(0_RPr);                  |
|              Fano2(k,Pr)                          |
|           )                                       |
|                                                   |
|o25 = FunctionClosure[currentString:112:29-117:6]  |
|                                                   |
|o25 : FunctionClosure                              |
+---------------------------------------------------+
|i26 : Grassmannian2(ZZ,ZZ) := (r,k) -> (           |
|              R := ZZ/31991[                       |
|                     vars(0..(binomial(r+1,k+1)-1))|
|                          ];                       |
|              Grassmannian2(k,r,R)                 |
|                           )                       |
|                                                   |
|o26 = FunctionClosure[currentString:118:24-123:22] |
|                                                   |
|o26 : FunctionClosure                              |
+---------------------------------------------------+

As a first example we can try the Fano of lines on the nonsingular quadric in
$\PP^3$

+-----------------------------------------------------------------------------+
|i27 : KK = ZZ/31991                                                          |
|                                                                             |
|o27 = KK                                                                     |
|                                                                             |
|o27 : QuotientRing                                                           |
+-----------------------------------------------------------------------------+
|i28 : R = KK[a,b,c,d]                                                        |
|                                                                             |
|o28 = R                                                                      |
|                                                                             |
|o28 : PolynomialRing                                                         |
+-----------------------------------------------------------------------------+
|i29 : X = ideal(a*b-c*d)                                                     |
|                                                                             |
|o29 = ideal(a*b - c*d)                                                       |
|                                                                             |
|o29 : Ideal of R                                                             |
+-----------------------------------------------------------------------------+
|i30 : I = Fano2(1,X)                                                         |
|                                                                             |
|                                                  2                          |
|o30 = ideal (p p , p p , p p  + 15995p p  - 15995p , p p  + p p , p p  -     |
|              3 4   2 4   1 4         0 5         5   0 4    4 5   2 3       |
|      -----------------------------------------------------------------------|
|                        2                                                    |
|      15995p p  - 15995p , p p , p p  - p p , p p , p p  - p p , p p  + p p ,|
|            0 5         5   1 3   0 3    3 5   1 2   0 2    2 5   0 1    1 5 |
|      -----------------------------------------------------------------------|
|       2    2                                                                |
|      p  - p )                                                               |
|       0    5                                                                |
