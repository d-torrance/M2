|                                     |
|o3 = M                               |
|                                     |
|o3 : GeneralOrderedMonoid            |
+-------------------------------------+
|i4 : class a                         |
|                                     |
|o4 = M                               |
|                                     |
|o4 : GeneralOrderedMonoid            |
+-------------------------------------+

