======================

  * "CC // CC"
  * "CC // QQ"
  * "CC // RR"
  * "CC // ZZ"
  * "List // Number"
  * "List // RingElement"
  * "Number // InfiniteNumber"
  * "Number // RingElement"
  * "QQ // QQ"
  * "QQ // ZZ"
  * "RingElement // Number"
  * "RingElement // RingElement"
  * "RR // QQ"
  * "RR // RR"
  * "RR // ZZ"
  * "ZZ // MonomialIdeal"
  * "ZZ // ZZ"
  * "Matrix // GroebnerBasis" -- see *note quotient(Matrix,Matrix):
