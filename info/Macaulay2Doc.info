+-------------------------------------------+
|i2 : QQ#{topLevelMode,AfterPrint} = r -> r;|
+-------------------------------------------+
|i3 : 3/4                                   |
|                                           |
|     3                                     |
|o3 = -                                     |
|     4                                     |
+-------------------------------------------+

