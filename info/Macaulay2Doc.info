  * "toCC(RR,RR)"
  * "toCC(ZZ)"
  * "toCC(ZZ,CC)"
  * "toCC(ZZ,QQ)"
  * "toCC(ZZ,QQ,QQ)"
  * "toCC(ZZ,QQ,RR)"
  * "toCC(ZZ,QQ,ZZ)"
  * "toCC(ZZ,RR)"
  * "toCC(ZZ,RR,QQ)"
  * "toCC(ZZ,RR,RR)"
  * "toCC(ZZ,RR,ZZ)"
  * "toCC(ZZ,ZZ)"
  * "toCC(ZZ,ZZ,QQ)"
  * "toCC(ZZ,ZZ,RR)"
  * "toCC(ZZ,ZZ,ZZ)"

