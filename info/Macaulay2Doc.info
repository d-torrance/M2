  * "map(Module,ZZ,ZZ)" -- see *note map(Module,Module,RingElement):
    map_lpModule_cmModule_cmRingElement_rp, -- construct the map induced by
    multiplication by a ring element on the generators
  * "map(Module,Module,RingMap,List)" -- see *note
    map(Module,Module,RingMap,Matrix):
    map_lpModule_cmModule_cmRingMap_cmMatrix_rp, -- homomorphism of modules
    over different rings
  * *note map(Module,Module,RingMap,Matrix):
    map_lpModule_cmModule_cmRingMap_cmMatrix_rp, -- homomorphism of modules
    over different rings
  * "map(Module,Nothing,RingMap,List)" -- see *note
    map(Module,Module,RingMap,Matrix):
    map_lpModule_cmModule_cmRingMap_cmMatrix_rp, -- homomorphism of modules
    over different rings
  * "map(Module,Nothing,RingMap,Matrix)" -- see *note
    map(Module,Module,RingMap,Matrix):
