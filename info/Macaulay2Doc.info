|                                                                             |
|o4 = Tally{((1, 1), 1) => 8}                                                 |
|           ((1, 1), 2) => 4                                                  |
|           ((1, 2), 1) => 4                                                  |
|           ((1, 2), 2) => 2                                                  |
|           ((2, 1), 1) => 4                                                  |
|           ((2, 1), 2) => 2                                                  |
