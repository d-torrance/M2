    inducedMap_lpModule_cmModule_cmMatrix_rp, -- compute the induced map
  * "inducedMap(Module,Nothing,Matrix)"
  * "inducedMap(Nothing,Module,Matrix)"
  * "inducedMap(Nothing,Nothing,Matrix)"
