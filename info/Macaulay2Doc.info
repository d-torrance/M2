|                        |
|o2 = Tally{1 => 1}      |
|           2 => 3       |
|                        |
|o2 : Tally              |
+------------------------+
|i3 : x ** y             |
|                        |
|o3 = Tally{(a, 1) => 2} |
|           (a, 2) => 6  |
|           (b, 1) => 1  |
|           (b, 2) => 3  |
|                        |
|o3 : Tally              |
