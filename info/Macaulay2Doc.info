|i5 : n                                        |
|                                              |
|o5 = 314172                                   |
+----------------------------------------------+
|i6 : sleep 1                                  |
|                                              |
|o6 = 0                                        |
+----------------------------------------------+
|i7 : t                                        |
|                                              |
|o7 = <<task, running>>                        |
|                                              |
|o7 : Task                                     |
+----------------------------------------------+
|i8 : n                                        |
|                                              |
|o8 = 893433                                   |
+----------------------------------------------+
|i9 : isReady t                                |
|                                              |
|o9 = false                                    |
+----------------------------------------------+
|i10 : cancelTask t                            |
+----------------------------------------------+
|i11 : sleep 2                                 |
|stdio:2:25:(3):[1]: error: interrupted        |
|                                              |
|o11 = 0                                       |
+----------------------------------------------+
|i12 : t                                       |
|                                              |
|o12 = <<task, canceled>>                      |
|                                              |
|o12 : Task                                    |
+----------------------------------------------+
|i13 : n                                       |
|                                              |
|o13 = 893682                                  |
+----------------------------------------------+
|i14 : sleep 1                                 |
|                                              |
|o14 = 0                                       |
+----------------------------------------------+
|i15 : n                                       |
|                                              |
|o15 = 893682                                  |
+----------------------------------------------+
