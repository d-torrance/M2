|     <mo>-</mo><mrow><mn>4</mn><mspace width="0.1667em"></mspace><mi>y</mi   |
|     <mo>+</mo><mn>1</mn>                                                    |
|     </mrow>                                                                 |
|-----------------------------------------------------------------------------|
|><mspace width="0.1667em"></mspace><mi>y</mi></mrow>                         |
|>y</mi><mn>2</mn></msup></mrow>                                              |
|></mrow>                                                                     |
|></mrow>                                                                     |
+-----------------------------------------------------------------------------+
+------------------------------------------------------+
|i3 : mathML matrix {{x,y},{x^2+2,0}}                  |
|                                                      |
|o3 = <mo>(</mo><mtable columnalign="center">          |
|     <mtr><mtd><mi>x</mi></mtd>                       |
