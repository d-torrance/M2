|i2 : p = matrix {{a,b,c},{d,e,f}}|
|                                 |
|o2 = | a b c |                   |
|     | d e f |                   |
|                                 |
|             2      3            |
|o2 : Matrix R  <-- R             |
+---------------------------------+
|i3 : p^{1}                       |
|                                 |
|o3 = | d e f |                   |
|                                 |
|             1      3            |
|o3 : Matrix R  <-- R             |
+---------------------------------+
|i4 : p^{1,0}                     |
|                                 |
|o4 = | d e f |                   |
|     | a b c |                   |
|                                 |
|             2      3            |
|o4 : Matrix R  <-- R             |
