|-----------------------------------------------------------------------------|
|");                                                                          |
+-----------------------------------------------------------------------------+
|i2 : f = x -> kernel (x|x);                                                  |
+-----------------------------------------------------------------------------+
|i3 : R = QQ[a..c];                                                           |
+-----------------------------------------------------------------------------+
|i4 : f vars R                                                                |
