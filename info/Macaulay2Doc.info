|                              |
|o7 = {{0}, {0}, {0}, {0}, {0}}|
|                              |
|o7 : List                     |
+------------------------------+
|i8 : degrees R^{1,2,3,4}      |
|                              |
|o8 = {{-1}, {-2}, {-3}, {-4}} |
|                              |
|o8 : List                     |
