|                                                           |
|o6 = r                                                     |
|                                                           |
|o6 : FunctionClosure                                       |
+-----------------------------------------------------------+
|i7 : r 0                                                   |
|                                                           |
|o7 = 15                                                    |
+-----------------------------------------------------------+

