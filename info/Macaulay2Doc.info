|o2 : MethodFunction            |
+-------------------------------+
|i3 : dismiss FirstPackage      |
|                               |
|o3 = FirstPackage              |
|                               |
|o3 : Package                   |
+-------------------------------+
|i4 : firstFunction             |
|                               |
|o4 = firstFunction             |
|                               |
|o4 : Symbol                    |
+-------------------------------+
|i5 : use FirstPackage          |
|                               |
|o5 = FirstPackage              |
|                               |
|o5 : Package                   |
+-------------------------------+
