|                                                 |
|o1 : HashTable                                   |
+-------------------------------------------------+
|i2 : pgfObject(circle(point(20,30),10),myoptions)|
|                                                 |
|o2 = \draw[fill=black] (20,30) circle (10);      |
+-------------------------------------------------+

