|                                       |
|o9 = HashTable{0 => Tally{}           }|
|               1 => Tally{{1, 0} => 1} |
|               2 => Tally{{0, 0} => 1} |
|                          {2, 0} => 1  |
|               3 => Tally{{1, 0} => 1} |
|                          {3, 0} => 1  |
|               4 => Tally{{0, 0} => 1} |
|                          {2, 0} => 1  |
|                          {4, 0} => 1  |
|                                       |
|o9 : HashTable                         |
+---------------------------------------+

