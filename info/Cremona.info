|Certify: output certified!                       |
|                                                 |
|o2 = true                                        |
+-------------------------------------------------+
|i3 : isBirational(f,Certify=>true,Verbose=>false)|
|                                                 |
|o3 = true                                        |
+-------------------------------------------------+

