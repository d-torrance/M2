|     e*c*a*b*d + e*c*a*d*b + e*c*b*a*d + e*c*b*d*a + e*c*d*a*b + e*c*d*b*a + |
|     ------------------------------------------------------------------------|
|     e*d*a*b*c + e*d*a*c*b + e*d*b*a*c + e*d*b*c*a + e*d*c*a*b + e*d*c*b*a   |
