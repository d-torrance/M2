|i3 : isStable(P, Q)            |
|                               |
|o3 = true                      |
+-------------------------------+
+---------------------------------------------+
|i4 : isStable ({0, 1}, bipartiteQuiver(2, 3))|
|                                             |
|o4 = false                                   |
+---------------------------------------------+
+-----------------------------------------------------------------------+
|i5 : Q = bipartiteQuiver(2, 3);                                        |
+-----------------------------------------------------------------------+
|i6 : S = first(subquivers(Q, Format => "quiver", AsSubquiver => true));|
+-----------------------------------------------------------------------+
|i7 : isStable (S, Q)                                                   |
|                                                                       |
|o7 = false                                                             |
