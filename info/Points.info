|o1 = R                                                                       |
|                                                                             |
|o1 : PolynomialRing                                                          |
+-----------------------------------------------------------------------------+
|i2 : M = transpose matrix{{0,0},{1,1}}                                       |
|                                                                             |
|o2 = | 0 1 |                                                                 |
|     | 0 1 |                                                                 |
|                                                                             |
|              2       2                                                      |
|o2 : Matrix ZZ  <-- ZZ                                                       |
+-----------------------------------------------------------------------------+
|i3 : mults = {3,2}                                                           |
|                                                                             |
|o3 = {3, 2}                                                                  |
|                                                                             |
|o3 : List                                                                    |
+-----------------------------------------------------------------------------+
