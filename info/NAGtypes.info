|o1 : PolynomialRing                                                          |
+-----------------------------------------------------------------------------+
|i2 : V := numericalAffineSpace R                                             |
|                                                                             |
|o2 = a "numerical variety" with components in                                |
|     dim 2:  (dim=2,deg=1)                                                   |
|                                                                             |
|o2 : NumericalVariety                                                        |
