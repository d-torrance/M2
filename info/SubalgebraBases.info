|                                        |
|o4 = -1                                 |
+----------------------------------------+
|i5 : sagbiDegree sagbi(S,Limit=>5)      |
|                                        |
|o5 = 6                                  |
+----------------------------------------+
|i6 : sagbiDegree sagbi(S,Limit=>20)     |
|                                        |
|o6 = 7                                  |
+----------------------------------------+
|i7 : isSAGBI(S,UseSubringGens=>false)   |
|                                        |
|o7 = true                               |
+----------------------------------------+

