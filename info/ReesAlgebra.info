|                                                                    |
|o1 = R                                                              |
|                                                                    |
|o1 : PolynomialRing                                                 |
+--------------------------------------------------------------------+
|i2 : M=matrix{{a,b,c,d},{e,f,g,h}}                                  |
|                                                                    |
|o2 = | a b c d |                                                    |
|     | e f g h |                                                    |
|                                                                    |
|             2      4                                               |
|o2 : Matrix R  <-- R                                                |
+--------------------------------------------------------------------+
|i3 : analyticSpread minors(2,M)                                     |
|                                                                    |
|o3 = 5                                                              |
