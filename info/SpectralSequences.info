|i2 : J = ideal vars B                                                        |
|                                                                             |
|o2 = ideal (a, b, c, d)                                                      |
|                                                                             |
|o2 : Ideal of B                                                              |
+-----------------------------------------------------------------------------+
|i3 : C = freeResolution monomialCurveIdeal(B,{1,3,4})                        |
|                                                                             |
|      1      4      4      1                                                 |
|o3 = B  <-- B  <-- B  <-- B                                                  |
|                                                                             |
|     0      1      2      3                                                  |
|                                                                             |
|o3 : Complex                                                                 |
+-----------------------------------------------------------------------------+
|i4 : K = filteredComplex(J,C,4)                                              |
|                                                                             |
|o4 = -5 : image 0 <-- image 0 <-- image 0 <-- image 0                        |
|                                                                             |
|          0           1           2           3                              |
|                                                                             |
|     -4 : image | a4 a3b a3c a3d a2b2 a2bc a2bd a2c2 a2cd a2d2 ab3 ab2c      |
|                                                                             |
|          0                                                                  |
|                                                                             |
|                                                                             |
|                                                                             |
|                                                                             |
|     -3 : image | a3 a2b a2c a2d ab2 abc abd ac2 acd ad2 b3 b2c b2d bc2      |
|                                                                             |
|          0                                                                  |
|                                                                             |
|                                                                             |
|                                                                             |
|                                                                             |
