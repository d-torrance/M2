|i1 : R = markovRing (3,2)                                                    |
|                                                                             |
|o1 = R                                                                       |
|                                                                             |
|o1 : PolynomialRing                                                          |
+-----------------------------------------------------------------------------+
|i2 : F = marginMap(1,R)                                                      |
|                                                                             |
|o2 = map (R, R, {p    - p    - p   , p    - p    - p   , p   , p   , p   ,   |
|                  1,1    2,1    3,1   1,2    2,2    3,2   2,1   2,2   3,1    |
|                                                                             |
|o2 : RingMap R <-- R                                                         |
|-----------------------------------------------------------------------------|
|p   })                                                                       |
| 3,2                                                                         |
+-----------------------------------------------------------------------------+
|i3 : G = inverseMarginMap(1,R)                                               |
|                                                                             |
|o3 = map (R, R, {p    + p    + p   , p    + p    + p   , p   , p   , p   ,   |
|                  1,1    2,1    3,1   1,2    2,2    3,2   2,1   2,2   3,1    |
|                                                                             |
|o3 : RingMap R <-- R                                                         |
|-----------------------------------------------------------------------------|
|p   })                                                                       |
| 3,2                                                                         |
+-----------------------------------------------------------------------------+
|i4 : gens R                                                                  |
|                                                                             |
|o4 = {p   , p   , p   , p   , p   , p   }                                    |
|       1,1   1,2   2,1   2,2   3,1   3,2                                     |
|                                                                             |
|o4 : List                                                                    |
+-----------------------------------------------------------------------------+
|i5 : F*G -- we see that the composition is the identity map:                 |
|                                                                             |
|o5 = map (R, R, {p   , p   , p   , p   , p   , p   })                        |
|                  1,1   1,2   2,1   2,2   3,1   3,2                          |
|                                                                             |
|o5 : RingMap R <-- R                                                         |
+-----------------------------------------------------------------------------+

