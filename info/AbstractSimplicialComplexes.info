|                               1 => {{1, 2}, {1, 3}, {1, 4}, {1, 5}, {2, 3}, |
|                               2 => {{1, 2, 3}, {1, 4, 5}, {2, 4, 5}, {2, 4, |
|                               3 => {{2, 4, 5, 7}}                           |
|                                                                             |
|o1 : AbstractSimplicialComplex                                               |
|-----------------------------------------------------------------------------|
|                                               }                             |
|                                                                             |
|{2, 4}, {2, 5}, {2, 7}, {4, 5}, {4, 7}, {5, 7}}                              |
|7}, {2, 5, 7}, {4, 5, 7}}                                                    |
+-----------------------------------------------------------------------------+
|i2 : C = simplicialChainComplex(K)                                           |
|                                                                             |
|       6       11       6       1                                            |
|o2 = ZZ  <-- ZZ   <-- ZZ  <-- ZZ                                             |
|                                                                             |
|     0       1        2       3                                              |
|                                                                             |
|o2 : Complex                                                                 |
