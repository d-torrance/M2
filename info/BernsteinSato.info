|                                        | 0 |                                |
|               HomologyModules => HashTable{0 => 0                 }         |
|                                            1 => cokernel | D_2-1 |          |
|                                                           1                 |
|               RestrictComplex => 0  <-- 0 <-- (QQ[x , D ])  <-- (QQ[x ,     |
|                                                    2   2             2      |
|                                  -1     0                                   |
|                                               1                 2           |
|                               1      2      1                               |
|               VResolution => R  <-- R  <-- R                                |
|                                                                             |
|                              0      1      2                                |
|                                                                             |
|o3 : HashTable                                                               |
|-----------------------------------------------------------------------------|
|     }                                                                       |
|                                                                             |
|                                                                             |
|                                                                             |
|                                                                             |
|                                                                             |
|                                                                             |
|                                                                             |
|                                                                             |
|    1                                                                        |
|D ])                                                                         |
