|     | 1 1 1 1 1 1  |                                                        |
|                                                                             |
|              3       6                                                      |
|o1 : Matrix ZZ  <-- ZZ                                                       |
+-----------------------------------------------------------------------------+
|i2 : cmVolumes(A)                                                            |
|                                                                             |
|                                                                             |
|o2 = {35, 20, -12}                                                           |
|                                                                             |
|o2 : List                                                                    |
+-----------------------------------------------------------------------------+
|i3 : A=matrix{{3, 0, 0, 1, 1,2}, {3,5,0,2,1,3},{0, 1, 2, 0, 2,0},{1, 1, 1, 1,|
|                                                                             |
|o3 = | 3 0 0 1 1 2 |                                                         |
|     | 3 5 0 2 1 3 |                                                         |
|     | 0 1 2 0 2 0 |                                                         |
|     | 1 1 1 1 1 1 |                                                         |
|                                                                             |
|              4       6                                                      |
|o3 : Matrix ZZ  <-- ZZ                                                       |
|-----------------------------------------------------------------------------|
|1,1}}                                                                        |
