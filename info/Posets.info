|               2 => 001                                 |
|               3 => 010                                 |
|               5 => 100                                 |
|               6 => 011                                 |
|               10 => 101                                |
|               15 => 110                                |
|               30 => 111                                |
|                                                        |
|o1 : HashTable                                          |
+--------------------------------------------------------+

