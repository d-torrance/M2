|i4 : peek xySlice                                                            |
|                                                                             |
|o4 = B'Slice{B'NumberCoefficients => {{1.49144+.713846*ii, -.840113+1.1986*  |
|             B'SectionString => {(1.49144+.713846*ii)*(x0)+(-.840113+1.1986  |
