  * "relabelGraph(Graph,ZZ,ZZ)"
  * "relabelGraph(List)"
  * "relabelGraph(List,ZZ)"
  * "relabelGraph(List,ZZ,ZZ)"
  * "relabelGraph(String)"
  * "relabelGraph(String,ZZ)"
  * "relabelGraph(String,ZZ,ZZ)"

