| -- setting random seed to 10206284518                                       |
+-----------------------------------------------------------------------------+
|i2 : FF=ZZ/10007;                                                            |
+-----------------------------------------------------------------------------+
|i3 : S=FF[x_0..x_7];                                                         |
+-----------------------------------------------------------------------------+
|i4 : (I,points)=randomCanonicalCurveGenus8with8Points S;                     |
