-- -*- M2-comint -*- hash: 10386987055572527526

i1 : D = makeWeylAlgebra(QQ[x,y], {1, 2});

i2 : I = ideal(x*dx^2 - y*dy^2 + dx-dy, x*dx+y*dy+1);

o2 : Ideal of D

i3 : A = pfaffianSystem I;

i4 : assert isIntegrable(D, A)

i5 : assert isIntegrable A

i6 : R = baseFractionField(D);

i7 : A = {sub(matrix{{1,1},{1,1}},R),sub(matrix{{1,0},{0,-1}},R)};

i8 : isIntegrable(D,A)

o8 = false

