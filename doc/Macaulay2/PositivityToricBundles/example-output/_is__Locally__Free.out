i1 : A3 = fan coneFromVData matrix {{1,0,0},{0,1,0},{0,0,1}};

i2 : filtMat = apply( { {{1,0},{0,1}}, {{0,1},{1,0}}, {{1,1},{1,0}} }, matrix);

i3 : filtStep = apply( { {{0,1}}, {{0,1}}, {{0,1}} }, matrix);

i4 : E = toricVectorBundle (2,A3,filtMat,filtStep);

i5 : details E

