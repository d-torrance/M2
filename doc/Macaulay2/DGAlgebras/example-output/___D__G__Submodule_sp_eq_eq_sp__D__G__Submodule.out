o6 : DGSubmodule

i7 : isSubset(S, U)

o7 = true

i8 : not isSubset(U, S)

o8 = true

i9 : S == S

o9 = true

i10 : M' = freeDGModule(A, {0})

o10 = {Base ring => R               }
       DG algebra => Anat
                             1
