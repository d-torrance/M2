-- -*- M2-comint -*- hash: 16960991478264923276

i1 : R = ZZ/101[x, y]

o1 = R

o1 : PolynomialRing

i2 : A = koszulComplexDGA R

o2 = {Ring => R                          }
      Underlying algebra => R[T   ..T   ]
                               1,1   1,2
      Differential => {x, y}

o2 : DGAlgebra

i3 : Anat = A.natural

o3 = Anat

o3 : PolynomialRing, 2 skew commutative variable(s)

i4 : I = dgIdeal(A, {x_Anat})

o4 = DGIdeal of Anat
     generators => | x |

o4 : DGIdeal

i5 : J = dgIdeal(A, {y_Anat})

o5 = DGIdeal of Anat
     generators => | y |

o5 : DGIdeal

i6 : K = intersect(I, J)

o6 = DGIdeal of Anat
     generators => | xy |

o6 : DGIdeal

i7 : isWellDefined K

o7 = true

i8 : Z = dgIdeal(A, {})

o8 = DGIdeal of Anat
     generators => 0

o8 : DGIdeal

i9 : ZI = intersect(Z, I)

o9 = DGIdeal of Anat
     generators => 0

o9 : DGIdeal

i10 : isWellDefined ZI

o10 = true

i11 : numgens ZI.natural == 0

o11 = true

