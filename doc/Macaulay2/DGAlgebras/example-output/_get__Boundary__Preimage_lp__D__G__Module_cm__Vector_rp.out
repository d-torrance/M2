i6 : b = x * natGens#0

o6 = | x |
     | 0 |

                    2
o6 : (R[T   ..T   ])
         1,1   1,2

i7 : (ok, pre) = getBoundaryPreimage(M, b)

o7 = (true, | T_(1,1) |)
            |    0    |

o7 : Sequence

i8 : assert(ok === true)

i9 : assert(diff(M, pre) == b)

