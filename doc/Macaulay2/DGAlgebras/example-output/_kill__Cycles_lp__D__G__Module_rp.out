i6 : prune homology(0, M2)

o6 = cokernel | x |

                            1
o6 : R-module, quotient of R

i7 : M3 = killCycles(M2, StartDegree => 1, EndDegree => 2)

o7 = {Base ring => R                                   }
      DG algebra => R[T   ]
                       1,1
                                 3
      Natural module => (R[T   ])
                            1,1
