       2,1     1,1,1    1

o11 : O

i12 : convert(m_{2,1}, Sn)

o12 = n    - 2n
       2,1     1,1,1

o12 : Sn

i13 : RRat = schurRing(QQ, rRat, 4, GroupActing => "RatGL");

i14 : convert(s_{2,1}, RRat)

o14 = rRat
          {{2, 1}, {}}

o14 : RRat

i15 : convert(s_{3} + 2*s_{1,1}, RRat)

o15 = rRat          + 2rRat
          {{3}, {}}        {{1, 1}, {}}

o15 : RRat

i16 : U = symmetricRing(QQ, 4);

i17 : convert(e_1 * h_2, S)

o17 = s  + s
       3    2,1

o17 : S

